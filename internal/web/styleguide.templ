package web

import "github.com/nofuturekid/tasmofleet/internal/web/ui"

// sgView is the style guide's data: the shell data (for the user menu and the drawer shown in
// the flow), the base path and the CSRF token of the sample forms.
type sgView struct {
	Base, CSRF string
	Shell      ui.ShellData
}

// sgSection is one section of /styleguide: its id (sg-<ID>, the anchor, the screenshot name in
// docs/design/styleguide/ and the heading docs/spec/design-system.md must have) and its title.
type sgSection struct{ ID, Title string }

// sgSections lists every section of the style guide in page order. styleguide_doc_test.go
// checks that docs/spec/design-system.md describes each one and that its screenshots exist.
var sgSections = []sgSection{
	{"banners", "Inline banners"},
	{"toasts", "Toasts"},
	{"live", "Live connection indicator"},
	{"buttons", "Buttons"},
	{"badges", "Badges, status dots and avatars"},
	{"cards", "Cards and key/value rows"},
	{"forms", "Form fields"},
	{"controls", "Choices and switches"},
	{"tiles", "Stat tiles and fleet health"},
	{"lists", "Attention list and transactions"},
	{"tabs", "Page header, crumbs and tabs"},
	{"menus", "Menus"},
	{"dialogs", "Dialogs"},
	{"states", "Empty, no match and loading"},
	{"errors", "Error page"},
	{"auth", "Sign-in card"},
	{"console", "Console"},
	{"diff", "Backup comparison"},
	{"notes", "Release notes"},
}

func sgTitle(id string) string {
	for _, s := range sgSections {
		if s.ID == id {
			return s.Title
		}
	}
	return id
}

// styleguidePage is the prototype's "UI states" screen (feedback) followed by the component
// gallery. All values are samples; nothing on the page comes from the fleet.
templ styleguidePage(v sgView) {
	@ui.PageHeader("Styleguide", "Inline banners, toasts and the live connection indicator, as used across TasmoFleet")
	<div class="sg-grid">
		<section class="ucard sg-sec" id="sg-banners" aria-labelledby="sg-banners-h">
			<h2 id="sg-banners-h">{ sgTitle("banners") }</h2>
			<p class="ucard-sub">Above the page content, under the page header. Stay until the cause is gone.</p>
			@ui.Banner(ui.BannerData{Tone: ui.ToneOK, Title: "Settings saved.", Text: "MQTT clients reconnect within a few seconds."})
			@ui.Banner(ui.BannerData{Tone: ui.ToneAccent, Title: "Tasmota 14.3.0 is available.", Text: "Released 6 Oct 2026 · 19 devices can update.", Action: &ui.Btn{Label: "Release notes"}})
			@ui.Banner(ui.BannerData{Tone: ui.ToneWarn, Title: "3 devices still run Tasmota 13.4.0.", Text: "That release no longer gets security fixes.", Action: &ui.Btn{Label: "Plan update"}})
			@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Title: "Couldn't save MQTT settings.", Text: "The broker refused the username or password.", Action: &ui.Btn{Label: "Retry"}, Alert: true})
		</section>
		<section class="ucard sg-sec" id="sg-toasts" aria-labelledby="sg-toasts-h">
			<h2 id="sg-toasts-h">{ sgTitle("toasts") }</h2>
			<p class="ucard-sub">Bottom right, newest last. Success fades after 4.5 s; failures stay until dismissed.</p>
			<div class="sg-toasts">
				@ui.ToastStatic(ui.ToastData{Tone: ui.ToneOK, Text: "5 backups saved", Action: "View"})
				@ui.ToastStatic(ui.ToastData{Tone: ui.ToneWarn, Text: "2 devices skipped: offline", Action: "Details"})
				@ui.ToastStatic(ui.ToastData{Tone: ui.ToneDanger, Text: "Restart failed on Laundry Ceiling Light: timed out", Action: "Retry"})
			</div>
			<div class="btn-row">
				<button type="button" class="btn" data-toast="Settings saved" data-toast-tone="ok">Show success</button>
				<button type="button" class="btn" data-toast="2 devices skipped: offline" data-toast-tone="warn">Show warning</button>
				<button type="button" class="btn" data-toast="Restart failed on Laundry Ceiling Light: timed out" data-toast-tone="danger">Show failure</button>
			</div>
		</section>
		<section class="ucard sg-sec sg-live" id="sg-live" aria-labelledby="sg-live-h">
			<h2 id="sg-live-h">{ sgTitle("live") }</h2>
			<p class="ucard-sub">Top bar, right of the navigation. Reconnecting and offline also show a banner.</p>
			<div class="sg-live-row">
				@ui.LivePill("ok", "Live")
				<span>Device state streams in. Last event 1 s ago.</span>
			</div>
			<div class="sg-live-row">
				@ui.LivePill("re", "Reconnecting…")
				<span>Connection dropped 6 s ago. Attempt 3, next try in 4 s. Values may be a few seconds old.</span>
			</div>
			<div class="sg-live-row">
				@ui.LivePill("off", "Offline")
				<span>No connection since 09:52. Values are frozen and changes are paused until it returns.</span>
			</div>
		</section>
	</div>
	<div class="sg-gallery">
		<div class="sg-gallery-head">
			<h2>Components</h2>
			<p>Every component of the design system with its variants and states, built from the same templ components as the pages. docs/spec/design-system.md describes each section.</p>
		</div>
		@sgSec("buttons") {
			@ui.ButtonRow() {
				@ui.Button(ui.Btn{Label: "Default"})
				@ui.Button(ui.Btn{Label: "Primary", Kind: "primary"})
				@ui.Button(ui.Btn{Label: "Danger", Kind: "danger"})
				@ui.Button(ui.Btn{Label: "Delete device", Kind: "danger-solid"})
				@ui.Button(ui.Btn{Label: "Ghost", Kind: "ghost"})
				@ui.Button(ui.Btn{Label: "Disabled", Disabled: true})
				@ui.Button(ui.Btn{Label: "A link that looks like a button", Href: v.Base + "/styleguide"})
			}
			@ui.ButtonRow() {
				@ui.Button(ui.Btn{Label: "Small", Small: true})
				@ui.Button(ui.Btn{Label: "Small primary", Kind: "primary", Small: true})
				@ui.Button(ui.Btn{Label: "⋯", Icon: true, Kind: "ghost", Small: true, Aria: "Actions"})
				@ui.Button(ui.Btn{Label: "Link", Kind: "link"})
			}
		}
		@sgSec("badges") {
			<div class="sg-row">
				@ui.Badge(ui.ToneOK, "Latest")
				@ui.Badge(ui.ToneOK, "Kept")
				@ui.Badge(ui.ToneAccent, "Newest")
				@ui.Badge(ui.ToneWarn, "3 flagged")
				@ui.Badge(ui.ToneDanger, "Failed")
				@ui.Badge(ui.ToneNeutral, "Disabled")
				@ui.Badge(ui.ToneAccent, "You")
				@ui.Badge(ui.ToneWarn, "Must change password")
			</div>
			<div class="sg-row">
				@ui.StatusDot(ui.ToneOK, "Online")
				@ui.StatusDot(ui.ToneDanger, "Offline")
				@ui.StatusDot(ui.ToneNeutral, "Unknown")
			</div>
			<div class="sg-row">
				@ui.Avatar("Maren Koch", "maren")
				@ui.Avatar("Jonas Brandt", "jonas")
				@ui.Avatar("ops", "ops")
			</div>
		}
		@sgSec("cards") {
			<div class="sg-cols">
				@ui.Card("Identity", "") {
					@ui.KV([]ui.KVRow{{Key: "Address", Value: "192.168.20.12", Mono: true}, {Key: "MAC", Value: "02:00:5E:9B:3E:01", Mono: true}, {Key: "Firmware", Value: "Tasmota 14.2.0", Mono: true}, {Key: "Module", Value: "Sonoff Basic (1)"}})
				}
				@ui.ListCard("Needs attention", "All devices", v.Base+"/styleguide") {
					@ui.AttentionList(nil, []ui.AttItem{{Tone: ui.ToneDanger, Name: "Garage Door Sensor", Text: "Offline for 3 h", Href: v.Base + "/styleguide"}}, v.CSRF)
				}
			</div>
		}
		@sgSec("forms") {
			@ui.ErrorSummary("Fix 1 field:")
			<div class="sg-form">
				@ui.Field(ui.FieldData{Label: "Name", Name: "sg-name", Value: "Balcony Windowsill", Wide: true, Help: "Shown in lists and in the device's own web page."})
				@ui.Field(ui.FieldData{Label: "Address", Name: "sg-addr", Value: "192.168.20.300", Mono: true, Error: "Enter an IP address or a hostname."})
				@ui.Field(ui.FieldData{Label: "Web password", Name: "sg-pw", Type: "password", Placeholder: "Unchanged", Help: "Leave empty to keep the stored password."})
				@ui.SelectField("Devices at a time", "sg-batch", []ui.Option{{Value: "1", Label: "1"}, {Value: "5", Label: "5", Checked: true}, {Value: "10", Label: "10"}})
			</div>
		}
		@sgSec("controls") {
			<div class="sg-cols">
				<div class="sg-stack">
					@ui.RadioCards("Sign-in method", "sg-auth", []ui.Option{{Value: "otp", Label: "One-time password", Text: "The user sets their own password at the first sign-in.", Checked: true}, {Value: "set", Label: "Set an initial password", Text: "You pass the password on yourself."}})
				</div>
				<div class="sg-stack">
					@ui.Segmented("Severity", "sg-sev", []ui.Option{{Value: "warn", Label: "Advisory"}, {Value: "require", Label: "Required", Checked: true}})
					@ui.Segmented("Diff layout", "sg-layout", []ui.Option{{Value: "side", Label: "Side by side", Checked: true}, {Value: "uni", Label: "Unified"}})
					@ui.Check("sg-keep", "Keep me signed in", "", true, false)
					@ui.Check("sg-names", "Device names in metric labels", "Off: labels use the device ID only.", false, true)
					@ui.Toggle("sg-metrics", "Expose Prometheus metrics", "Serves device state, power and transaction counters at /metrics.", true, false)
					<div class="sg-row">
						@ui.PowerSwitch("Power on", true, false)
						@ui.PowerSwitch("Power off", false, false)
						@ui.PowerSwitch("Power (device offline)", false, true)
					</div>
				</div>
			</div>
		}
		@sgSec("tiles") {
			<div class="stat-grid">
				@ui.StatTile(ui.StatTileData{Tone: ui.ToneOK, Label: "Online", Value: "54", Hint: "of 60 devices", Href: v.Base + "/styleguide"})
				@ui.StatTile(ui.StatTileData{Tone: ui.ToneDanger, Label: "Offline", Value: "4", Hint: "since the last poll", Href: v.Base + "/styleguide"})
				@ui.StatTile(ui.StatTileData{Tone: ui.ToneNeutral, Label: "Unknown", Value: "2", Hint: "not reached yet", Href: v.Base + "/styleguide"})
				@ui.StatTile(ui.StatTileData{Tone: ui.ToneAccent, Label: "Can update", Value: "19", Hint: "to 14.3.0", Href: v.Base + "/styleguide"})
			</div>
			@ui.HealthBar(54, 4, 2)
		}
		@sgSec("lists") {
			<div class="sg-cols">
				@ui.ListCard("Needs attention", "All devices", v.Base+"/styleguide") {
					@ui.AttentionList([]ui.AttProposal{{Name: "Kitchen Plug", Text: "New address 192.168.20.41 announced", Primary: "Update address", Secondary: "Ignore", PrimaryAction: v.Base + "/styleguide", SecondaryAction: v.Base + "/styleguide"}}, []ui.AttItem{{Tone: ui.ToneDanger, Name: "Garage Door Sensor", Text: "Offline for 3 h", Href: v.Base + "/styleguide"}, {Tone: ui.ToneWarn, Name: "Hallway Light", Text: "Not compliant: TelePeriod 300, rule wants 60", Href: v.Base + "/styleguide"}}, v.CSRF)
				}
				@ui.ListCard("Update transactions", "History", v.Base+"/styleguide") {
					@ui.TxnCard(ui.TxnData{ID: "TX-0148", Title: "Tasmota 14.3.0 for 19 devices", State: "Running", StateTone: ui.ToneAccent, Summary: "11 done · 1 failed · 3 running · 4 waiting", OK: 11, Failed: 1, Active: 3, Total: 19, Href: v.Base + "/styleguide"})
					@ui.TxnRow(ui.TxnRowData{ID: "TX-0147", Title: "Tasmota 14.2.0 for 6 devices", Result: "Succeeded", Tone: ui.ToneOK, When: "2 days ago", Href: v.Base + "/styleguide"})
					@ui.TxnRow(ui.TxnRowData{ID: "TX-0146", Title: "Tasmota 14.2.0 for 3 devices", Result: "1 failed", Tone: ui.ToneDanger, When: "5 days ago", Href: v.Base + "/styleguide"})
					<div class="att-row">
						<span class="att-text"><span class="att-name">Living Room Lamp</span><span class="att-why">Uploading the image</span></span>
						@ui.MiniBar(64)
					</div>
				}
			</div>
		}
		@sgSec("tabs") {
			@ui.Crumbs([]ui.Crumb{{Label: "Devices", Path: "/styleguide"}, {Label: "Balcony Windowsill", Path: "/styleguide"}}, v.Base)
			@ui.PageHeader("Balcony Windowsill", "Sonoff Basic · Tasmota 14.2.0") {
				@ui.Button(ui.Btn{Label: "Restart…"})
				@ui.Button(ui.Btn{Label: "Back up now", Kind: "primary"})
			}
			@ui.Tabs("Device pages", []ui.Tab{{Label: "Overview", Href: v.Base + "/styleguide", Current: true}, {Label: "Settings", Href: v.Base + "/styleguide"}, {Label: "Console", Reason: "The device has not answered yet."}, {Label: "Backups", Href: v.Base + "/styleguide", Badge: 3}})
		}
		@sgSec("menus") {
			<div class="sg-flow sg-menus">
				<div>
					<p class="sg-label">Row menu</p>
					@ui.RowMenuStatic("Actions for Balcony Windowsill", []ui.MenuItem{{Label: "Open", Href: v.Base + "/styleguide"}, {Label: "Open console", Href: v.Base + "/styleguide"}, {Label: "Back up now", Href: v.Base + "/styleguide"}, {Label: "Restart…", Href: v.Base + "/styleguide"}, {Label: "Delete…", Href: v.Base + "/styleguide", Danger: true, Sep: true}}, false)
				</div>
				<div>
					<p class="sg-label">Disabled entries say why</p>
					@ui.RowMenuStatic("Actions for Maren Koch", []ui.MenuItem{{Label: "Change role", Disabled: true, Why: "You can't change your own role."}, {Label: "Reset password", Href: v.Base + "/styleguide"}, {Label: "Delete user", Disabled: true, Why: "The last admin can't be deleted.", Sep: true}}, false)
				</div>
				<div>
					<p class="sg-label">User menu</p>
					@ui.UserMenuStatic(v.Shell)
				</div>
				<div class="sg-drawer">
					<p class="sg-label">Phone navigation drawer</p>
					@ui.NavList(v.Shell)
				</div>
			</div>
		}
		@sgSec("dialogs") {
			<div class="sg-flow sg-dialogs">
				@ui.Dialog(ui.DialogData{ID: "sg-dlg-restart", Title: "Restart 3 devices?", Body: "Relays switch off for a few seconds. Connected lights will flicker.", Changes: []ui.KVRow{{Key: "Balcony Windowsill", Value: "Restart 1"}, {Key: "Kitchen Plug", Value: "Restart 1"}, {Key: "Hallway Light", Value: "Restart 1"}}, Action: v.Base + "/styleguide", CSRF: v.CSRF, Verb: "Restart 3 devices", Static: true})
				@ui.Dialog(ui.DialogData{ID: "sg-dlg-delete", Title: "Delete Balcony Windowsill?", Body: "Removes the device and its history from TasmoFleet. The device itself is not touched. This cannot be undone.", Action: v.Base + "/styleguide", CSRF: v.CSRF, Verb: "Delete device", Danger: true, Static: true})
				@ui.StepUp(ui.StepUpData{ID: "sg-stepup", Name: "Maren Koch", Sub: "Maren Koch · last sign-in 1 h 52 min ago", What: "Changing a user's role", IdP: "Authentik", IdPHref: v.Base + "/styleguide", Local: true, Action: v.Base + "/styleguide", CSRF: v.CSRF, Static: true})
			</div>
		}
		@sgSec("states") {
			@ui.Empty("No devices yet", "Scan your network for Tasmota devices, add one by address, or bring over your existing TasmoAdmin setup.") {
				@ui.Button(ui.Btn{Label: "Scan network", Kind: "primary", Href: v.Base + "/styleguide"})
				@ui.Button(ui.Btn{Label: "Add manually", Href: v.Base + "/styleguide"})
			}
			@ui.NoMatch("No device matches “garage” with the filter Offline / unknown.", v.Base+"/styleguide")
			@ui.Skeleton("Loading devices…", 4)
		}
		@sgSec("errors") {
			@ui.ErrorPage("404", "This page doesn't exist", "The address may be mistyped, or the device or transaction it pointed to was deleted.", "/devices/d99", ui.Btn{Label: "Go to the dashboard", Kind: "primary", Href: v.Base + "/styleguide"}, ui.Btn{Label: "All devices", Href: v.Base + "/styleguide"})
		}
		@sgSec("auth") {
			@ui.AuthCard(v.Base, "1.4.2", "fleet.lab.home") {
				<h1>Sign in</h1>
				@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Title: "Wrong username or password.", Text: "2 attempts left before this account is locked for 15 minutes.", Alert: true})
				@ui.Field(ui.FieldData{Label: "Username", Name: "sg-user", Value: "maren", Autocomplete: "off"})
				@ui.Field(ui.FieldData{Label: "Password", Name: "sg-pass", Type: "password", Error: "Check the password and try again.", Autocomplete: "off"})
				@ui.Check("sg-remember", "Keep me signed in", "", true, false)
				@ui.Button(ui.Btn{Label: "Sign in", Kind: "primary"})
			}
		}
		@sgSec("console") {
			@ui.Console(ui.ConsoleData{Title: "Console · MQTT + HTTP · 192.168.20.12", Action: v.Base + "/styleguide", CSRF: v.CSRF, Lines: []ui.ConsoleLine{{Time: "09:52:01", Text: "Power", Kind: "cmd"}, {Time: "09:52:01", Text: `{"POWER":"ON"}`}, {Time: "09:52:07", Text: "Status 5", Kind: "cmd"}, {Time: "09:52:07", Text: `{"StatusNET":{"Hostname":"balcony","IPAddress":"192.168.20.12"}}`}, {Time: "09:52:15", Text: "Reset 1", Kind: "cmd"}, {Time: "09:52:15", Text: "Refused: Reset is not on the command allowlist.", Kind: "err"}}, Quick: []string{"Power", "Status 5", "Status 11", "Restart 1"}})
		}
		@sgSec("diff") {
			<div class="sg-cols">
				@ui.Diff(ui.DiffData{OldLabel: "3 Oct 09:12", NewLabel: "12 Oct 21:40", Rows: sgDiffRows})
				@ui.Diff(ui.DiffData{OldLabel: "3 Oct 09:12", NewLabel: "12 Oct 21:40", Rows: sgDiffRows, Unified: true})
			</div>
		}
		@sgSec("notes") {
			@ui.Notes([]ui.NoteBlock{
				{Kind: "p", Text: "Tasmota 14.3.0 brings faster Wi-Fi reconnects and new sensor drivers."},
				{Kind: "breaking", Text: "Breaking changes", Items: []string{"SetOption65 is removed; use the new Rule syntax.", "ESP8266 1M builds no longer include the web updater."}},
				{Kind: "h", Text: "Added"},
				{Kind: "ul", Items: []string{"Support for the BL0942 energy monitor", "Command TelePeriod accepts 5 seconds"}},
				{Kind: "code", Text: "Backlog TelePeriod 60; SaveData 1"},
			})
		}
	</div>
}

// sgSec is one gallery section with its anchor and heading.
templ sgSec(id string) {
	<section class="ucard sg-sec" id={ "sg-" + id } aria-labelledby={ "sg-" + id + "-h" }>
		<h2 id={ "sg-" + id + "-h" }>{ sgTitle(id) }</h2>
		{ children... }
	</section>
}

var sgDiffRows = []ui.DiffRow{
	{Key: "FriendlyName1", Old: "Balcony Windowsill", New: "Balcony Windowsill"},
	{Key: "TelePeriod", Old: "300", New: "60", Changed: true},
	{Key: "PowerOnState", Old: "3", New: "3"},
	{Key: "LedState", Old: "8", New: "1", Changed: true},
}
