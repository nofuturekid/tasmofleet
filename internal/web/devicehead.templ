package web

import (
	"strconv"

	"github.com/nofuturekid/tasmofleet/internal/model"
	"github.com/nofuturekid/tasmofleet/internal/web/ui"
)

// nameOfferNotice says what the device calls itself while the stored name differs (#125). The
// stored name is never overwritten; "Use device name" adopts it, "Keep" declines exactly this name.
templ nameOfferNotice(c identCard) {
	<div class="banner tone-warn name-offer" role="status">
		<span class="banner-dot"></span>
		<div class="banner-text">Name on the device: <b>{ c.NameOffer }</b></div>
		if c.CanAnswer {
			<div class="banner-actions">
				<button type="button" class="banner-btn" hx-post={ c.Base + devPath(c.ID, "/name/adopt") } hx-vals={ nameVals(c.NameOffer) } hx-target="#identity" hx-swap="outerHTML" hx-disabled-elt="this">Use device name</button>
				if c.KeepOK {
					<button type="button" class="banner-btn" hx-post={ c.Base + devPath(c.ID, "/name/keep") } hx-vals={ nameVals(c.NameOffer) } hx-target="#identity" hx-swap="outerHTML" hx-disabled-elt="this">Keep</button>
				}
			</div>
		}
	</div>
}

// deviceHeader is the header of every device tab (prototype screen "device"): the name with the
// state, the address / chip / firmware line, the device buttons, the offline banner and the tabs.
// Buttons are plain forms and links; dialog.js turns Restart into a dialog. Delete leads to the
// delete page (N2): a dialog could not carry the backup list, the choice and the acknowledgement.
templ deviceHeader(t deviceTabs) {
	@deviceHead(t, nil)
	@deviceHeadRest(t)
}

// deviceHeadSwap is what a successful "Refresh identity" sends besides the identity card: the
// header, the breadcrumb, phone title and page title, out of band, so they show the refreshed name,
// address, chip and firmware without a reload (#104).
templ deviceHeadSwap(t deviceTabs, crumbs []ui.Crumb) {
	@deviceHead(t, templ.Attributes{"hx-swap-oob": "true"})
	@deviceOffSlot(t, templ.Attributes{"hx-swap-oob": "true"})
	if t.CanRestart {
		@restartDialog(t, true)
	}
	@ui.CrumbsOOB(crumbs, t.Base)
	@ui.PhoneTitleOOB(t.Name)
	<title>{ t.Name } - TasmoFleet</title>
}

// deviceHead is the name, state, meta line and buttons of the header.
templ deviceHead(t deviceTabs, attrs templ.Attributes) {
	<div class="devhd" id="devhd" { attrs... }>
		<div class="devhd-t">
			<div class="devhd-name">
				<h1>{ t.Name }</h1>
				<span class={ "devhd-state", "t-" + string(t.stateTone()) }><span class="devhd-dot" aria-hidden="true"></span>{ t.stateLabel() }</span>
			</div>
			<div class="devhd-meta">
				<span data-visual-mask>{ t.Address }</span>
				if t.Chip != "" {
					<span>{ t.Chip }</span>
				}
				if t.Version != "" {
					<span>Tasmota { t.Version }</span>
				}
				if t.UpdateTo != "" {
					<form method="post" action={ templ.SafeURL(t.Base + "/updates/new") } class="devhd-upd">
						<input type="hidden" name="csrf" value={ t.CSRF }/>
						<input type="hidden" name="id" value={ strconv.FormatInt(int64(t.ID), 10) }/>
						<button
							type="submit"
							disabled?={ t.updateBtnWhy() != "" }
							if t.updateBtnWhy() != "" {
								title={ t.updateBtnWhy() }
								aria-disabled="true"
								aria-describedby={ t.updateDescribedBy() }
							}
						>Update to { t.UpdateTo }</button>
					</form>
				}
			</div>
			if t.backupNote() != "" {
				<p class="devcard-note" id="devhd-why">Back up: { t.backupNote() }</p>
			}
		</div>
		<div class="devhd-acts">
			if t.CanRestart {
				if t.Health == model.HealthOffline {
					<button type="button" class="btn" disabled>Restart</button>
				} else {
					@ui.Button(ui.Btn{Label: "Restart", Href: t.Base + devPath(t.ID, "/restart"), Dialog: "dlg-restart"})
				}
			}
			<form method="post" action={ templ.SafeURL(t.Base + devPath(t.ID, "/backup")) }>
				<input type="hidden" name="csrf" value={ t.CSRF }/>
				<input type="hidden" name="back" value={ t.backPath() }/>
				<button
					type="submit"
					class="btn"
					disabled?={ t.BackupWhy != "" }
					if t.BackupWhy != "" {
						title={ t.BackupWhy }
						aria-disabled="true"
						aria-describedby={ t.backupDescribedBy() }
					}
				>Back up</button>
			</form>
			if t.IsAdmin {
				@ui.Button(ui.Btn{Label: "Edit", Href: t.Base + devPath(t.ID, "/edit")})
				@ui.Button(ui.Btn{Label: "Delete", Kind: "danger", Href: t.Base + devPath(t.ID, "/delete")})
			}
		</div>
	</div>
}

// deviceHeadRest is what follows the header block: the tabs, the offline banner under them (as in the mockup) and the restart dialog.
templ deviceHeadRest(t deviceTabs) {
	@ui.Tabs("Device pages", t.headTabs())
	@deviceOffSlot(t, nil)
	if t.CanRestart {
		@restartDialog(t, false)
	}
}

// deviceOffSlot holds the offline banner. The slot is always on the page, so a live refresh can
// put the banner in when the device goes offline and take it out when it is back (#126).
templ deviceOffSlot(t deviceTabs, attrs templ.Attributes) {
	<div id="devhd-slot" { attrs... }>
		if t.offline() {
			@deviceOffBanner(t)
		}
	</div>
}

// deviceOffBanner says the device is offline and since when; its id lets a refresh swap it (#110).
templ deviceOffBanner(t deviceTabs) {
	<div class="devhd-off" id="devhd-off" role="status">
		<span class="devhd-offdot" aria-hidden="true"></span>
		<div>
			if !t.OfflineSince.IsZero() {
				<b>Offline since <time data-visual-mask { ui.StampAttrs(t.OfflineSince, ui.StampDay)... }>{ t.OfflineSinceText }</time>.</b>
			} else {
				<b>Offline.</b> The device has not answered since TasmoFleet started.
			}
			Everything below is the last reported state. Switching, Restart, Back up and Refresh identity are disabled until the device is back; Edit and Delete still work.
		</div>
	</div>
}

// restartDialog is the Restart confirmation, named after the device. oob: sent by a refresh that
// may have renamed the device, over the dialog already on the page (#110).
templ restartDialog(t deviceTabs, oob bool) {
	@ui.Dialog(ui.DialogData{ID: "dlg-restart", Title: "Restart " + t.Name + "?", Body: "Its relays switch off for a few seconds.", Action: t.Base + devPath(t.ID, "/restart"), CSRF: t.CSRF, Verb: "Restart", OOB: oob})
}

// deviceOverviewPage is the overview tab (#145): the live tiles, the relay box, Identity next to
// Connection and the Activity list. Offline dims everything but Activity.
templ deviceOverviewPage(p deviceOverview) {
	@deviceHeader(p.Tabs)
	if u := p.Updating; u != nil {
		@ui.Banner(ui.BannerData{Tone: ui.ToneAccent, Title: updatingTitle(u.Job), Text: u.StepLabel + ". " + updatingText(u.Job), Action: &ui.Btn{Label: "Follow the transaction", Href: p.Base + "/transactions/" + strconv.FormatInt(int64(u.Job.BatchID), 10)}})
	}
	if p.NotYet != "" {
		@ui.Banner(ui.BannerData{Tone: ui.ToneNeutral, Text: p.NotYet})
	}
	@liveRegion(p.Live)
	<div class="dev-pair">
		@identityCard(p.Ident)
		<section id="devconn" class={ "devcard", dimClass(p.Live.Off) } data-dim aria-disabled={ ariaBool(p.Live.Off) } aria-labelledby="dc-conn">
			<h2 id="dc-conn">{ p.Conn.Title }</h2>
			@ui.KV(p.Conn.Rows)
		</section>
	</div>
	if p.Paths != nil {
		@pathsCard(*p.Paths)
	}
	@devActBox(p.Activity, nil)
}

// deviceLiveParts is the answer of the live refresh: the region the page replaces, and the
// Activity box, the header and the offline banner out of band.
templ deviceLiveParts(p deviceOverview) {
	@liveRegion(p.Live)
	@devActBox(p.Activity, templ.Attributes{"hx-swap-oob": "true"})
	if p.Paths != nil {
		@pathsLive(*p.Paths)
	}
	@deviceHead(p.Tabs, templ.Attributes{"hx-swap-oob": "true"})
	@deviceOffSlot(p.Tabs, templ.Attributes{"hx-swap-oob": "true"})
}

// liveRegion is the tile row and the relay box. It asks for itself again when this device
// changes state or finishes a command (devstate-N, devjob-N), when its readings arrive
// (power-N, uptime-N, at most every 10 s) and when the stream was missed (resync, #160).
templ liveRegion(l liveView) {
	<div
		id="devlive"
		class="devlive"
		data-off?={ l.Off }
		hx-get={ l.Base + devPath(l.ID, "/live") }
		hx-trigger={ "sse:devstate-" + devID(l.ID) + " throttle:2s, sse:devjob-" + devID(l.ID) + " throttle:2s, sse:power-" + devID(l.ID) + " throttle:10s, sse:uptime-" + devID(l.ID) + " throttle:10s, sse:resync" }
		hx-swap="outerHTML"
	>
		<div class="dev-tiles">
			for _, t := range l.Tiles {
				@liveTile(t, l)
			}
		</div>
		if l.Box != nil {
			@relayBoxView(l)
		} else if l.Sensors != nil {
			@sensorBoxView(l)
		}
	</div>
}

func dimClass(off bool) string {
	if off {
		return "dev-dim is-dim"
	}
	return "dev-dim"
}

func toneClass(t ui.Tone) string {
	if t == "" {
		return ""
	}
	return "t-" + string(t)
}

templ liveTile(t tile, l liveView) {
	<div class={ "dev-tile", dimClass(l.Off) } data-tile={ t.Key } data-dim aria-disabled={ ariaBool(l.Off) }>
		<div class="dev-tile-l">{ t.Label }</div>
		<div class={ "dev-tile-v", toneClass(t.Tone) } data-visual-mask?={ t.Mask }>{ t.Value }</div>
		if t.Bar > 0 {
			<svg class={ "dev-bar", toneClass(t.BarTone) } viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true" data-visual-mask>
				<rect class="dev-bar-track" x="0" y="0" width="100" height="6"></rect>
				<rect class="dev-bar-fill" x="0" y="0" width={ strconv.Itoa(t.Bar) } height="6"></rect>
			</svg>
		}
		<div class="dev-tile-s">
			if !t.At.IsZero() {
				{ t.SubPrefix }<time data-visual-mask { ui.StampAttrs(t.At, ui.StampDay)... }>{ t.AtText }</time>
			} else {
				{ t.Sub }
			}
		</div>
		if t.Fix {
			<form method="post" action={ templ.SafeURL(l.Base + "/policy/fix") }>
				<input type="hidden" name="csrf" value={ l.CSRF }/>
				<input type="hidden" name="only" value={ devID(l.ID) }/>
				<button type="submit" class="btn dev-tile-fix">Make compliant…</button>
			</form>
		}
	</div>
}

// relayBoxView is the box of relay switches: always the same four-column box, for one relay as
// well as for four. The switches are forms that also work without JavaScript; htmx replaces the
// live region with the answer.
templ relayBoxView(l liveView) {
	<section class={ "devcard", "dev-box", dimClass(l.Off) } data-dim aria-disabled={ ariaBool(l.Off) } aria-labelledby="dc-relays">
		<div class="devcard-head">
			<h2 id="dc-relays">Relays</h2>
			<span class="dev-box-meta">{ l.Box.Right }</span>
		</div>
		<div class="dev-relays">
			for _, rl := range l.Box.Rows {
				<form
					method="post"
					action={ templ.SafeURL(l.Base + devPath(l.ID, "/power/"+strconv.Itoa(rl.N))) }
					class="dev-relay"
					hx-post={ l.Base + devPath(l.ID, "/power/"+strconv.Itoa(rl.N)) }
					hx-target="#devlive"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="csrf" value={ l.CSRF }/>
					<input type="hidden" name="action" value={ rl.Action }/>
					<input type="hidden" name="back" value="device"/>
					<div class="dev-relay-t">
						<span class="dev-relay-n">{ rl.Name } <span class="mono">{ rl.Cmd }</span></span>
						<span class="dev-relay-s" data-visual-mask>{ rl.Line }</span>
					</div>
					<button type="submit" class="devrelay-sw" role="switch" aria-checked={ ariaBool(rl.On) } aria-label={ rl.Aria } disabled?={ !l.Box.Enabled }><span class="devsw" aria-hidden="true"></span></button>
				</form>
			}
		</div>
		if l.Box.Err != "" {
			<p class="error" role="alert">{ l.Box.Err }</p>
		}
	</section>
}

// sensorBoxView is the Sensors box that takes the place of the relay box on a device without
// relays. Its readings are the last ones received: dimmed with the rest while the device is offline.
templ sensorBoxView(l liveView) {
	<section class={ "devcard", "dev-box", dimClass(l.Off) } data-dim aria-disabled={ ariaBool(l.Off) } aria-labelledby="dc-sensors">
		<div class="devcard-head">
			<h2 id="dc-sensors">Sensors</h2>
			<span class="dev-box-meta">{ l.Sensors.Right }</span>
		</div>
		if len(l.Sensors.Cells) > 0 {
			<div class="dev-relays">
				for _, c := range l.Sensors.Cells {
					<div class="dev-sensor">
						<span class="dev-sensor-l">{ c.Label }</span>
						<span class="dev-sensor-v" data-visual-mask>{ c.Value }</span>
					</div>
				}
			</div>
		} else {
			<p class="devcard-note">{ l.Sensors.Note }</p>
		}
	</section>
}

// devActBox is the Activity list: state changes and transactions of the device, newest first.
// It is history, so an offline device does not dim it.
templ devActBox(a devActivity, attrs templ.Attributes) {
	<section id="devact" class="devcard" aria-labelledby="dc-act" { attrs... }>
		<div class="devcard-head">
			<h2 id="dc-act">Activity</h2>
			<a class="btn btn-link" href={ templ.SafeURL(a.All) }>All activity</a>
		</div>
		if len(a.Rows) > 0 {
			@devActList(a.Rows, a.Base)
		} else {
			<p class="devcard-note">No state changes or transactions yet. Online/offline changes, updates and commands appear here, newest first.</p>
		}
	</section>
}

templ devActList(rows []devActRow, base string) {
	<ul class="dev-act">
		for _, r := range rows {
			<li>
				<time class="dev-act-at" { ui.StampAttrs(r.At, ui.StampDateTimeSec)... }>{ ui.StampText(r.At, ui.StampDateTimeSec) }</time>
				if e := r.Event; e != nil {
					<span class="dev-act-what">@ui.Badge(uiTone(e.From), label(e.From)) <span aria-label="to">→</span> @ui.Badge(uiTone(e.To), label(e.To))</span>
					<span class="dev-act-more">{ string(e.Source) }{ healthMore(e.Source, e.Detail) }</span>
				} else if j := r.Job; j != nil {
					<span class="dev-act-what"><a href={ templ.SafeURL(base + "/transactions/" + strconv.FormatInt(int64(j.BatchID), 10)) }>Transaction #{ strconv.FormatInt(int64(j.BatchID), 10) }</a> @ui.Badge(uiTone(j.State), label(j.State))</span>
					<span class="dev-act-more">
						{ j.Target() }
						if j.LastError != "" {
							· <span class="reason" title={ tip(j.LastError) }>{ humanReason(j.LastError) }</span>
						}
					</span>
				}
			</li>
		}
	</ul>
}

// deviceHistoryPage is every state change and transaction of a device, paged (the overview shows
// the newest few).
templ deviceHistoryPage(p historyView) {
	@deviceHeader(p.Tabs)
	<section class="devcard" aria-labelledby="dc-hist">
		<div class="devcard-head">
			<h2 id="dc-hist">Activity</h2>
			<a class="btn btn-link" href={ templ.SafeURL(p.Base + devPath(p.Tabs.ID, "")) }>Back to the overview</a>
		</div>
		if len(p.Rows) > 0 {
			@devActList(p.Rows, p.Base)
		} else {
			<p class="devcard-note">No state changes or transactions yet. Online/offline changes, updates and commands appear here, newest first.</p>
		}
		@pagerNav(p.Pager)
	</section>
}

// identityCard is the Identity card; "Refresh identity" asks the device again and swaps the card.
templ identityCard(c identCard) {
	<section id="identity" class={ "devcard", dimClass(c.Off) } data-dim aria-disabled={ ariaBool(c.Off) } aria-labelledby="dc-ident">
		<div class="devcard-head">
			<h2 id="dc-ident">Identity</h2>
			if c.CanProbe {
				<button type="button" class="btn btn-link" hx-post={ c.Base + devPath(c.ID, "/probe") } hx-target="#identity" hx-swap="outerHTML" hx-disabled-elt="this" data-needs-device disabled?={ c.Off }>Refresh identity</button>
			}
		</div>
		@ui.KV(c.Rows)
		if c.NameOffer != "" {
			@nameOfferNotice(c)
		}
		if c.Error != "" {
			@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: c.Error, Alert: true})
		}
		if c.Notice != "" {
			@ui.Banner(ui.BannerData{Tone: ui.ToneOK, Text: c.Notice})
		}
	</section>
}
