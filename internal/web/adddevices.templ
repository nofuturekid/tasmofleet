package web

import (
	"strconv"

	"github.com/nofuturekid/tasmofleet/internal/web/ui"
)

// The Add page (#410): the header and four boxes, no tabs. The CSS is the "Add devices" block of
// app.css (.add-*, .scard-add).

// addPageView is the page: Discovered and Network scan in the wide stack, Add manually and Import
// from TasmoAdmin in the narrow one. The rank classes give the phone order: Discovered, Add manually,
// Network scan, Import.
templ addPageView(p addPage) {
	<div class="add-head"><h1>Add devices</h1></div>
	if p.Manual.Error != "" && p.Manual.ErrField == "" {
		@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: p.Manual.Error, Alert: true})
	}
	if p.Disc != nil {
		@discBanners(*p.Disc)
	}
	@ui.CardStacks(3) {
		if p.Disc != nil {
			@ui.CardStack(2) {
				@addBox("discovered", "r1", "Discovered", strconv.Itoa(p.Disc.NewCount), "Found by MQTT discovery and network scans, waiting for an admin.") {
					@discoveredBody(*p.Disc)
				}
				@addBox("scan", "r3", "Network scan", "", "Probes the ranges for Tasmota devices; new ones appear under Discovered.") {
					@scanBox(*p.Scan)
				}
			}
		}
		@ui.CardStack(1) {
			@addBox("manual", "r2", "Add manually", "", "By address, when you know it.") {
				@addManualForm(p.Manual)
			}
			if p.Import != nil {
				@addBox("import", "r4", "Import from TasmoAdmin", "", "Takes over the device list of a TasmoAdmin installation.") {
					@importBodyPart(*p.Import)
				}
			}
		}
	}
}

// addBox is one box of the Add page: a card of the column-stack grid with a title (and the count of
// what waits in it), a one-line note and its body.
templ addBox(id, rank, title, count, note string) {
	<section class={ "scard", "scard-add", rank } id={ "card-" + id }>
		<div class="sch">
			<div>
				<h2>
					{ title }
					if count != "" && count != "0" {
						{ " " }
						@ui.Badge(ui.ToneAccent, count)
					}
				</h2>
				<p class="cnote">{ note }</p>
			</div>
		</div>
		<div class="sbody sbody-plain">
			{ children... }
		</div>
	</section>
}

// ---- Add manually ----

templ addManualForm(f addManualView) {
	<form class="add-manual" method="post" action={ templ.SafeURL(f.Base + "/devices/new") }>
		<input type="hidden" name="csrf" value={ f.CSRF }/>
		if f.Prefill != nil {
			<input type="hidden" name="prefilled" value={ f.Prefill.Source }/>
			<div class="add-note tone-accent" role="status">
				<span class="add-note-dot" aria-hidden="true"></span>
				<span class="add-note-text">
					Prefilled from { f.Prefill.Source }:
					if f.Prefill.Name != "" {
						<b>{ f.Prefill.Name }</b>
					}
					if f.Prefill.Host != "" {
						<span class="mono">{ f.Prefill.Host }</span>
					}
					· <span class="mono" data-visual-mask>{ f.Prefill.Address }</span>
				</span>
				<a class="btn btn-sm" href={ templ.SafeURL(f.Base + "/devices/new") }>Clear</a>
			</div>
		}
		if f.Tested != nil {
			<div class="add-note tone-ok" role="status">
				<span class="add-note-dot" aria-hidden="true"></span>
				<span class="add-note-text">
					<b>Connected.</b> { testedText(*f.Tested) } Nothing was added yet.
				</span>
			</div>
		}
		@ui.Field(ui.FieldData{Label: "IP address or hostname", Name: "address", Value: f.Device.Address, Mono: true, Wide: true,
			Autocomplete: "off", Error: f.FieldError("address")})
		<label class="ufield">
			<span class="ufield-label">Web user</span>
			<input value="admin" readonly class="mono" aria-describedby="add-user-help"/>
			<span class="ufield-help" id="add-user-help">Tasmota’s web user is always admin.</span>
		</label>
		@ui.Field(ui.FieldData{Label: "Web password", Name: "http_password", Type: "password", Autocomplete: "new-password",
			Placeholder: f.PasswordPlaceholder(), Help: f.PasswordHelp(), Error: f.FieldError("http_password")})
		if f.HasDefault && f.Prefill == nil {
			<input type="hidden" name="use_default_password" value="1"/>
		}
		<details class="add-more" open?={ f.MoreOpen() }>
			<summary>More options</summary>
			<div class="add-more-grid">
				@ui.Field(ui.FieldData{Label: "Name", Name: "name", Value: f.Device.Name, Help: "Optional, read from the device when empty.", Error: f.FieldError("name")})
				@ui.Field(ui.FieldData{Label: "Port", Name: "port", Type: "number", Value: portText(f.Device.Port), Placeholder: "80", Help: "Empty means 80.", Error: f.FieldError("port")})
				@ui.Field(ui.FieldData{Label: "Tags", Name: "tags", Value: f.TagsText, Wide: true, Help: "Comma separated.", Error: f.FieldError("tags")})
				<label class="ufield ufield-wide">
					<span class="ufield-label">Notes</span>
					<textarea name="notes" rows="3" maxlength="4000"
						if f.FieldError("notes") != "" {
							aria-invalid="true"
							aria-describedby="err-notes"
						}
					>{ f.Device.Notes }</textarea>
					if f.FieldError("notes") != "" {
						<span class="ufield-err" id="err-notes">{ f.FieldError("notes") }</span>
					} else {
						<span class="ufield-help">Free text for you; not sent to the device.</span>
					}
				</label>
				<label class="ucheck ufield-wide" title="A device with this on is never offered firmware, for example one that must not be touched remotely.">
					<input type="checkbox" name="ota_excluded" value="1" checked?={ f.Device.OTAExcluded }/>
					<span>Exclude from OTA updates</span>
				</label>
			</div>
		</details>
		if f.Fallback {
			<label class="ucheck ufield-wide">
				<input type="checkbox" name="skip_probe" value="1"/>
				<span>Add without probing the device</span>
			</label>
		}
		if f.NoNetworks {
			<p class="add-off" id="add-off">Adding is off until a device network is configured (see the notice above): every address would be refused.</p>
		}
		<div class="add-acts">
			<button type="submit" class="btn btn-primary" disabled?={ f.NoNetworks }
				if f.NoNetworks {
					aria-describedby="add-off"
				}
			>Add device</button>
			<button type="submit" name="test" value="1" class="btn" disabled?={ f.NoNetworks }>Test connection</button>
		</div>
	</form>
}

// ---- Discovered ----

templ discBanners(p discView) {
	if p.Error != "" {
		@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: p.Error, Alert: true})
	}
	if p.Unverified != nil {
		<form class="banner tone-danger add-confirm" role="alert" method="post" action={ templ.SafeURL(p.Base + "/discovery/proposals/" + strconv.FormatInt(p.Unverified.ProposalID, 10) + "/accept") }>
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			<input type="hidden" name="version" value={ p.Unverified.Version }/>
			<input type="hidden" name="token" value={ p.Unverified.Token }/>
			<span class="banner-dot"></span>
			<div class="banner-text">
				Could not verify that <code>{ p.Unverified.Target }</code> is the same device as { p.Unverified.Name } (MAC). The stored web password will be sent there, possibly to a different host.
			</div>
			<button type="submit" class="btn btn-danger-solid">Update address anyway</button>
			<a class="btn" href={ templ.SafeURL(p.Base + "/devices/new") }>Cancel</a>
		</form>
	}
}

// discoveredBody is the Discovered box: the note about a switched-off discovery, the address changes
// and conflicts a known device reported, then the new devices (and, with ?ignored=1, the ignored ones)
// with selection, Ignore and Add…, then the topics MQTT saw but could not identify.
templ discoveredBody(p discView) {
	if p.Off {
		<div class="add-note tone-warn" role="status">
			<span class="add-note-dot" aria-hidden="true"></span>
			<span class="add-note-text"><b>MQTT discovery is switched off.</b> Only network scans find new devices.</span>
			if p.Settings != "" {
				<a class="btn btn-sm" href={ templ.SafeURL(p.Settings) }>Open settings</a>
			}
		</div>
	}
	if len(p.Moves) > 0 {
		@moveSection("Address changed", "Known devices that announced themselves at a new IP and can’t be moved automatically.", p.Moves, p)
	}
	if len(p.Conflicts) > 0 {
		@moveSection("Conflicts", "Another device claims the address or topic of a known device. Nothing is changed until you resolve it.", p.Conflicts, p)
	}
	<form class="add-newdev" method="post" action={ templ.SafeURL(p.Base + "/discovery/proposals/accept") }>
		<input type="hidden" name="csrf" value={ p.CSRF }/>
		if p.HasDefault {
			<input type="hidden" name="use_default_password" value="1"/>
		}
		<input type="hidden" name="state" value={ p.State }/>
		<input type="hidden" name="sort" value={ p.Sort }/>
		<input type="hidden" name="dir" value={ p.Dir }/>
		if p.ShowIgn {
			<input type="hidden" name="ignored" value="1"/>
		}
		<div class="add-bar">
			<h3 class="sys-subhead">New devices ({ strconv.Itoa(p.NewCount) })</h3>
			<a class="add-showign" role="checkbox" aria-checked={ ariaBool(p.ShowIgn) } href={ templ.SafeURL(showIgnoredHref(p)) }>
				<span class="add-box" aria-hidden="true"></span>
				<span>Show ignored ({ strconv.Itoa(p.Ignored) })</span>
			</a>
			<span class="add-gap"></span>
			if p.NewCount > 0 {
				<div class="btn-row" data-bulkbar>
					<button type="submit" class="btn" formaction={ templ.SafeURL(p.Base + "/discovery/proposals/dismiss") }>Ignore selected</button>
					<button type="submit" class="btn btn-primary">Add <span data-bar-count></span> selected</button>
				</div>
			}
		</div>
		if len(p.Chips) > 0 && (len(p.Rows) > 0 || p.Filtered) {
			<div class="add-chips" role="group" aria-label="Filter by state">
				for _, c := range p.Chips {
					<a class={ "add-chip", templ.KV("is-on", c.Current) } href={ templ.SafeURL(c.Href) }
						if c.Current {
							aria-current="true"
						}
					>{ c.Label }<span class="add-chip-n">{ strconv.Itoa(c.N) }</span></a>
				}
			</div>
		}
		if p.Filtered {
			<div class="uempty add-empty">
				<div class="uempty-icon" aria-hidden="true"><span></span></div>
				<h2>No { p.State } devices</h2>
				<p>No device in this list is { p.State } right now.</p>
			</div>
		} else if len(p.Rows) == 0 {
			<div class="uempty add-empty">
				<div class="uempty-icon" aria-hidden="true"><span></span></div>
				<h2>No new devices found</h2>
				if p.Off {
					<p>MQTT discovery is off, so only network scans add devices here.</p>
				} else {
					<p>
						Discovery is listening on MQTT. New Tasmota devices show up here a few seconds after they join the network.
						if !p.LastAnnounce.IsZero() {
							Last announcement <time { ui.StampAttrs(p.LastAnnounce, ui.StampDay)... }>{ p.LastAnnounceText }</time>.
						}
					</p>
				}
			</div>
		} else {
			<div class="add-table add-disc-table">
				<table>
					<colgroup>
						<col class="c-sel"/>
						<col class="c-name"/>
						<col class="c-ip"/>
						<col class="c-src"/>
						<col class="c-last"/>
						<col class="c-act"/>
					</colgroup>
					<thead>
						<tr>
							<th class="sel"><input type="checkbox" data-select-all hidden aria-label="Select all"/></th>
							@sortTh(p, "name", "Device name")
							@sortTh(p, "ip", "IP")
							@sortTh(p, "source", "Source")
							@sortTh(p, "last", "Last seen")
							<th class="act"><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, r := range p.Rows {
							<tr class={ templ.KV("is-ign", r.Ignored) }>
								<td class="sel">
									if !r.Ignored {
										<input type="checkbox" name="id" value={ strconv.FormatInt(r.ID, 10) + ":" + r.Version } aria-label={ "Select " + r.Label() }/>
									}
								</td>
								<td class="name" title={ nameTip(r) }>
									<span class="add-label">
										<span class="add-label-t">{ dash(r.Name) }</span>
										if r.Ignored {
											@ui.Badge(ui.ToneNeutral, "Ignored")
										}
										if r.Offline {
											@ui.Badge(ui.ToneWarn, "Offline")
											if r.OfflineText != "" {
												<span class="add-t2">since <time datetime={ r.OfflineSince.UTC().Format("2006-01-02T15:04:05Z") }>{ r.OfflineText }</time></span>
											}
										}
									</span>
								</td>
								<td class="mono" title={ r.Address }>{ r.Address }</td>
								<td>
									if r.MQTT {
										@ui.Badge(ui.ToneAccent, r.Source)
									} else {
										@ui.Badge(ui.ToneNeutral, r.Source)
									}
								</td>
								<td class="add-t2"><time datetime={ r.Last.UTC().Format("2006-01-02T15:04:05Z") }>{ r.LastText }</time></td>
								<td class="act">
									if r.Ignored {
										<button type="submit" class="btn btn-sm" formaction={ templ.SafeURL(p.Base + "/discovery/proposals/" + strconv.FormatInt(r.ID, 10) + "/undismiss") }>Restore</button>
									} else {
										<button type="submit" class="btn btn-ghost add-ign" formaction={ templ.SafeURL(p.Base + "/discovery/proposals/" + strconv.FormatInt(r.ID, 10) + "/dismiss") }>Ignore</button>
										<a class="btn btn-sm" href={ templ.SafeURL(r.AddHref) } title="Add with a web password">Add…</a>
										<button type="submit" class="btn btn-primary" formaction={ templ.SafeURL(p.Base + "/discovery/proposals/" + strconv.FormatInt(r.ID, 10) + "/accept") } name="version" value={ r.Version }>Add</button>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="add-cards">
				for _, r := range p.Rows {
					<div class={ "add-card", templ.KV("is-ign", r.Ignored) }>
						<label class="add-card-sel">
							if !r.Ignored {
								<input type="checkbox" name="id" value={ strconv.FormatInt(r.ID, 10) + ":" + r.Version } aria-label={ "Select " + r.Label() }/>
							}
						</label>
						<div class="add-card-body">
							<span class="add-card-title">
								<span class="add-card-name">{ r.Label() }</span>
								if r.Ignored {
									@ui.Badge(ui.ToneNeutral, "Ignored")
								}
								if r.Offline {
									@ui.Badge(ui.ToneWarn, "Offline")
									if r.OfflineText != "" {
										<span class="add-t2">since <time datetime={ r.OfflineSince.UTC().Format("2006-01-02T15:04:05Z") }>{ r.OfflineText }</time></span>
									}
								}
							</span>
							<span class="add-card-meta"><span data-visual-mask>{ r.Address }</span>{ metaTail(cardHost(r)) }</span>
							<span class="add-card-src">{ r.Source } · last seen <time datetime={ r.Last.UTC().Format("2006-01-02T15:04:05Z") }>{ r.LastText }</time></span>
							if r.Ignored {
								<button type="submit" class="btn add-card-btn" formaction={ templ.SafeURL(p.Base + "/discovery/proposals/" + strconv.FormatInt(r.ID, 10) + "/undismiss") }>Restore</button>
							} else {
								<div class="add-card-acts">
									<button type="submit" class="btn" formaction={ templ.SafeURL(p.Base + "/discovery/proposals/" + strconv.FormatInt(r.ID, 10) + "/dismiss") }>Ignore</button>
									<a class="btn" href={ templ.SafeURL(r.AddHref) }>Add…</a>
									<button type="submit" class="btn btn-primary" formaction={ templ.SafeURL(p.Base + "/discovery/proposals/" + strconv.FormatInt(r.ID, 10) + "/accept") } name="version" value={ r.Version }>Add</button>
								</div>
							}
						</div>
					</div>
				}
			</div>
		}
	</form>
	if len(p.Unident) > 0 {
		@unidentSection(p.Unident)
	}
}

// unidentSection lists the topics MQTT saw that are no proposal yet (spec 11.3a): offline
// devices without a discovery config, unanswered Status 5, addresses outside the networks.
templ unidentSection(rows []moveRow) {
	<section class="add-moves" aria-label="Seen on MQTT, not identified yet">
		<div class="add-moves-head">
			<h2>Seen on MQTT, not identified yet ({ strconv.Itoa(len(rows)) })</h2>
			<div class="add-moves-sub">These topics are on the broker, but TasmoFleet does not know their MAC yet, so they cannot be added. They appear under New devices once identified.</div>
		</div>
		for _, m := range rows {
			<div class="add-move">
				<span class="add-move-name">
					<span class="mono">{ m.Name }</span>
					<span class="add-move-seen"><time datetime={ m.Seen.UTC().Format("2006-01-02T15:04:05Z") }>{ m.SeenText }</time></span>
				</span>
				<span class="add-move-addr mono" data-visual-mask>{ dash(m.New) }</span>
				<span class="add-move-why">{ m.Why }</span>
			</div>
		}
	</section>
}

// moveSection lists known devices that reported a new address (or a conflict): Dismiss, and
// Apply where the move can be confirmed here.
templ moveSection(title, sub string, rows []moveRow, p discView) {
	<section class="add-moves" aria-label={ title }>
		<div class="add-moves-head">
			<h2>{ title } ({ strconv.Itoa(len(rows)) })</h2>
			<div class="add-moves-sub">{ sub }</div>
		</div>
		for _, m := range rows {
			<form class="add-move" method="post" action={ templ.SafeURL(p.Base + "/discovery/proposals/" + strconv.FormatInt(m.ID, 10) + "/accept") }>
				<input type="hidden" name="csrf" value={ p.CSRF }/>
				<input type="hidden" name="version" value={ m.Version }/>
				<span class="add-move-name">
					if m.Href != "" {
						<a href={ templ.SafeURL(m.Href) }>{ m.Name }</a>
					} else {
						<span>{ m.Name }</span>
					}
					<span class="add-move-seen"><time datetime={ m.Seen.UTC().Format("2006-01-02T15:04:05Z") }>{ m.SeenText }</time></span>
				</span>
				<span class="add-move-addr mono">
					if m.Old != "" {
						<span class="add-t2" data-visual-mask>{ m.Old }</span> →
					}
					<b>{ m.New }</b>
				</span>
				<span class="add-move-why">{ m.Why }</span>
				<span class="btn-row add-move-acts">
					<button type="submit" class="btn" formaction={ templ.SafeURL(p.Base + "/discovery/proposals/" + strconv.FormatInt(m.ID, 10) + "/dismiss") }>Dismiss</button>
					if m.CanApply {
						<button type="submit" class="btn btn-primary">Apply</button>
					}
				</span>
			</form>
		}
	</section>
}

// ---- Network scan ----

// scanPage is the results page of one scan: the heading, a way back to the Add page and the scan body.
templ scanPage(t scanTab) {
	<div class="add-head"><h1>Network scan</h1></div>
	@scanBody(t.Body)
	<p class="ufield-help"><a href={ templ.SafeURL(t.Body.Base + "/devices/new") }>Back to Add devices</a></p>
}

// scanBox is the Network scan box of the Add page: the ranges, Scan now (it opens the results page,
// where the scan runs live), the line about the last scan with a link to all its results, and the
// scheduled scan's state. A scan that is running shows its progress and a link to watch it.
templ scanBox(b scanBodyView) {
	<div id="scan" class="add-scan">
		<form class="add-scanbar" method="post" action={ templ.SafeURL(b.Base + "/discovery/scan") }>
			<input type="hidden" name="csrf" value={ b.CSRF }/>
			<input class="mono add-subnet" name="cidrs" value={ b.CIDRs } placeholder="192.168.1.0/24" aria-label="Subnet"/>
			<button type="submit" class="btn btn-primary" disabled?={ b.NoNetworks || b.Running }
				if b.NoNetworks {
					aria-describedby="scan-off"
				}
			>Scan now</button>
			<span class="add-scanstatus">
				<span data-visual-mask>
					{ b.StatusLead }
					if !b.StatusAt.IsZero() {
						<time { ui.StampAttrs(b.StatusAt, ui.StampDay)... }>{ b.StatusAtText }</time>
					}
					{ b.StatusTail }
				</span>
			</span>
			if b.Prefilled != "" {
				<span class="ufield-help add-scanerr" id="scan-prefill-note">{ b.Prefilled }</span>
			}
			if b.NoNetworks {
				<span class="ufield-help add-scanerr" id="scan-off">Scanning is off until a device network is configured (see the notice above).</span>
			}
		</form>
		if b.Running {
			<div class="add-note tone-accent" role="status">
				<span class="add-note-dot pulse" aria-hidden="true"></span>
				<span class="add-note-text">
					<b>Scanning { b.Ranges }.</b> { strconv.Itoa(b.Done) } of { strconv.Itoa(b.Total) } addresses.
					<a href={ templ.SafeURL(b.Base + "/discovery/scan/" + b.ID) }>Watch the scan</a>
				</span>
			</div>
		} else if b.HasScan && b.Summary != "" {
			<div class="add-note tone-ok" role="status">
				<span class="add-note-dot" aria-hidden="true"></span>
				<span class="add-note-text">
					<b>Scan finished.</b> { b.BoxSummary }
					<a href={ templ.SafeURL(b.Base + "/discovery/scan/" + b.ID) }>All results</a>
				</span>
			</div>
		}
		if b.Scheduled != "" {
			<p class="ufield-help">
				Scheduled scan: { b.Scheduled }.
				if b.SettingsHref != "" {
					<a href={ templ.SafeURL(b.SettingsHref) }>Settings → Discovery</a>
				}
			</p>
		}
	</div>
}

// scanBody is the tab body. While a scan runs the event stream swaps only the progress and the results
// (#scan-live, event "scan"): the scan bar with its Stop button stays untouched, so a click on it is not
// lost to a re-render (#144). The last event ("scan-done") replaces the whole body with a version
// without stream attributes, so the browser stops listening.
templ scanBody(b scanBodyView) {
	<div
		id="scan"
		class="add-scan"
		if b.Running {
			hx-ext="sse"
			sse-connect={ scanStreamURL(b) }
			sse-swap="scan-done"
			hx-swap="outerHTML"
		}
	>
		<form class="add-scanbar" method="post" action={ templ.SafeURL(b.Base + "/discovery/scan") }>
			<input type="hidden" name="csrf" value={ b.CSRF }/>
			<input
				class="mono add-subnet"
				name="cidrs"
				value={ b.CIDRs }
				placeholder="192.168.1.0/24"
				aria-label="Subnet"
				if b.Error != "" {
					aria-invalid="true"
					aria-describedby="err-cidrs"
				}
			/>
			if b.Running {
				<button type="submit" class="btn" formaction={ templ.SafeURL(b.Base + "/discovery/scan/" + b.ID + "/cancel") }>Stop scan</button>
			} else {
				<button type="submit" class="btn btn-primary" disabled?={ b.NoNetworks }
					if b.NoNetworks {
						aria-describedby="scan-off"
					}
				>Scan now</button>
			}
			<span class="add-scanstatus">
				<span data-visual-mask>
					{ b.StatusLead }
					if !b.StatusAt.IsZero() {
						<time { ui.StampAttrs(b.StatusAt, ui.StampDay)... }>{ b.StatusAtText }</time>
					}
					{ b.StatusTail }
				</span>
			</span>
			if b.Error != "" {
				<span class="ufield-err add-scanerr" id="err-cidrs">{ b.Error }</span>
			}
			if b.Prefilled != "" {
				<span class="ufield-help add-scanerr" id="scan-prefill-note">{ b.Prefilled }</span>
			}
			if b.NoNetworks {
				<span class="ufield-help add-scanerr" id="scan-off">Scanning is off until a device network is configured (see the notice above).</span>
			}
		</form>
		<div
			id="scan-progress"
			if b.Running {
				sse-swap="scan-progress"
				hx-swap="innerHTML"
			}
		>
			@scanProgress(b)
		</div>
		<div
			id="scan-live"
			if b.Running {
				sse-swap="scan"
				hx-swap="innerHTML"
			}
		>
			@scanLive(b)
		</div>
	</div>
}

// scanProgress is the progress bar of a running scan, or the note of a finished one. The stream swaps
// it on every tick; it holds nothing to click.
templ scanProgress(b scanBodyView) {
	if b.Running {
		<div class="add-progress" role="status">
			<div class="add-progress-head">
				<span class="add-progress-t"><span class="add-note-dot pulse" aria-hidden="true"></span><b>Scanning { b.Ranges }</b></span>
				<span class="mono add-t2">{ strconv.Itoa(b.Done) } of { strconv.Itoa(b.Total) } addresses</span>
			</div>
			<progress max={ strconv.Itoa(max(b.Total, 1)) } value={ strconv.Itoa(b.Done) }>{ strconv.Itoa(b.Percent()) } %</progress>
			<div class="add-progress-found">Found { strconv.Itoa(b.Found) } Tasmota devices so far</div>
		</div>
	} else if b.HasScan {
		<div class="add-note tone-ok" role="status">
			<span class="add-note-dot" aria-hidden="true"></span>
			<span class="add-note-text"><b>Scan finished.</b> { b.Summary }</span>
		</div>
	}
}

// sortTh is a sortable header of the New devices table: a plain link (no script), the current
// column marked and announced.
templ sortTh(p discView, key, label string) {
	{{ href, class, aria := sortHeader(p, key) }}
	<th aria-sort={ aria }><a class={ class } href={ templ.SafeURL(href) }>{ label }<span class="sortmark" aria-hidden="true"></span></a></th>
}

// scanLive is filter chips, bulk bar and the table. The stream swaps it only when a device was found,
// so ticks and clicks are not lost to a refresh that changes nothing.
templ scanLive(b scanBodyView) {
	if b.HasScan {
		<form method="post" action={ templ.SafeURL(b.Base + "/discovery/proposals/accept") }>
			<input type="hidden" name="csrf" value={ b.CSRF }/>
			if b.HasDefault {
				<input type="hidden" name="use_default_password" value="1"/>
			}
			<div class="add-chips">
				for _, c := range b.Chips {
					<a class={ "add-chip", templ.KV("is-on", c.Current) } href={ templ.SafeURL(c.Href) }
						if c.Current {
							aria-current="true"
						}
					>{ c.Label }<span class="add-chip-n">{ strconv.Itoa(c.N) }</span></a>
				}
				<span class="add-gap"></span>
				if b.Selectable {
					<div class="btn-row" data-bulkbar>
						<button type="submit" class="btn btn-primary">Add <span data-bar-count></span> selected</button>
					</div>
				}
			</div>
			if len(b.Rows) == 0 && b.More == 0 {
				<div class="uempty add-empty">
					<div class="uempty-icon" aria-hidden="true"><span></span></div>
					if b.Running {
						<h2>Nothing found so far</h2>
						<p>The scan is still probing.</p>
					} else {
						<h2>Nothing found</h2>
						<p>No Tasmota device answered in these ranges.</p>
					}
				</div>
			} else {
				<div class="add-table add-scan-table">
					<table>
						<colgroup>
							<col class="c-sel"/>
							<col class="c-name"/>
							<col class="c-ip"/>
							<col class="c-mac"/>
							<col class="c-fw"/>
							<col class="c-st"/>
							<col class="c-act"/>
						</colgroup>
						<thead>
							<tr>
								<th class="sel">
									if b.Selectable {
										<input type="checkbox" data-select-all hidden aria-label="Select all"/>
									}
								</th>
								<th>Name</th>
								<th>IP</th>
								<th>MAC</th>
								<th>Firmware</th>
								<th>Status</th>
								<th class="act"><span class="sr-only">Actions</span></th>
							</tr>
						</thead>
						<tbody>
							for _, r := range b.Rows {
								<tr>
									<td class="sel">
										if r.Kind == "new" {
											<input type="checkbox" name="id" value={ strconv.FormatInt(r.ProposalID, 10) + ":" + r.Version } aria-label={ "Select " + r.Name }/>
										}
									</td>
									<td class="name" title={ r.Name }><span class="add-label">{ r.Name }</span></td>
									<td class="mono" title={ r.Address } data-visual-mask>{ r.Address }</td>
									<td class="mono add-t2" title={ r.MAC } data-visual-mask>{ r.MAC }</td>
									<td class="mono">{ dash(r.Firmware) }</td>
									<td>
										@ui.Badge(r.Tone, r.Label)
									</td>
									<td class="act">
										@scanRowActs(b, r)
									</td>
								</tr>
							}
						</tbody>
					</table>
					if b.More > 0 {
						<a class="add-more-known" href={ templ.SafeURL(b.MoreHref) }>and { strconv.Itoa(b.More) } more known devices</a>
					}
				</div>
				<div class="add-cards">
					for _, r := range b.Rows {
						<div class="add-card add-scan-card">
							<div class="add-card-body">
								<span class="add-card-title">
									<span class="add-card-name">{ r.Name }</span>
									@ui.Badge(r.Tone, r.Label)
								</span>
								<span class="add-card-meta"><span data-visual-mask>{ r.Address }</span>{ metaTail(r.Firmware) }</span>
								<span class="add-card-src mono" data-visual-mask>{ r.MAC }</span>
								<div class="add-card-acts">
									@scanRowActs(b, r)
								</div>
							</div>
						</div>
					}
					if b.More > 0 {
						<a class="add-more-known" href={ templ.SafeURL(b.MoreHref) }>and { strconv.Itoa(b.More) } more known devices</a>
					}
				</div>
			}
		</form>
	}
}

templ scanRowActs(b scanBodyView, r scanRow) {
	switch {
		case r.Kind == "new":
			<button type="submit" class="btn btn-ghost add-ign" formaction={ templ.SafeURL(b.Base + "/discovery/proposals/" + strconv.FormatInt(r.ProposalID, 10) + "/dismiss") }>Ignore</button>
			<a class="btn btn-sm" href={ templ.SafeURL(r.AddHref) }>Add</a>
		case r.Kind == "ignored":
			<button type="submit" class="btn btn-link" formaction={ templ.SafeURL(b.Base + "/discovery/proposals/" + strconv.FormatInt(r.ProposalID, 10) + "/undismiss") }>Un-ignore</button>
		case r.OpenHref != "":
			<a class="btn btn-link" href={ templ.SafeURL(r.OpenHref) }>Open</a>
		case r.ReviewRef != "":
			<a class="btn btn-link" href={ templ.SafeURL(r.ReviewRef) }>Review</a>
		case r.AddHref != "":
			<a class="btn btn-sm" href={ templ.SafeURL(r.AddHref) }>Add</a>
	}
}

// ---- Import from TasmoAdmin ----

// importBodyPart is the drop zone and the plan or result below it; the upload and Apply answer
// with a new one (hx-target="#import").
templ importBodyPart(b importBody) {
	<div id="import" class="add-import" aria-live="polite">
		if b.Report == nil {
			<form
				class="add-drop"
				hx-post={ b.Base + "/import/tasmoadmin" }
				hx-encoding="multipart/form-data"
				hx-trigger="change"
				hx-target="#import"
				hx-swap="outerHTML"
				data-dropzone
			>
				<span class="add-drop-text">
					if len(b.Uploaded) > 0 {
						for i, n := range b.Uploaded {
							if i > 0 {
								{ listSep(i, len(b.Uploaded)) }
							}
							<b>{ n }</b>
						}
						{ "uploaded from TasmoAdmin" }
						<span class="add-drop-sub">Drop other files here to replace them.</span>
					} else {
						<b>devices.csv</b>{ " from TasmoAdmin, with " }<b>MyConfig.json</b>{ " and " }<b>.device-password.key</b>{ " if you have them" }
						<span class="add-drop-sub">Drop the files here. They are read in memory, never stored; each may be up to 1 MiB.</span>
					}
				</span>
				<label class="btn add-drop-btn">
					Choose files
					<input type="file" name="files" multiple class="add-drop-input" accept=".csv,.json,.key,text/csv,application/json"/>
				</label>
			</form>
		}
		if b.Error != "" {
			@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: b.Error, Alert: true})
		}
		if b.Plan != nil {
			for _, w := range b.Plan.Warnings {
				@ui.Banner(ui.BannerData{Tone: ui.ToneWarn, Text: w})
			}
			if b.Plan.Hint != "" {
				@ui.Banner(ui.BannerData{Tone: ui.ToneAccent, Text: b.Plan.Hint})
			}
			<section class="add-plan" aria-labelledby="imp-plan-h">
				<div class="add-plan-head">
					<h2 id="imp-plan-h">Import plan</h2>
					<span class="add-plan-counts">
						@ui.Badge(ui.ToneOK, strconv.Itoa(b.Plan.Create)+" create")
						@ui.Badge(ui.ToneAccent, strconv.Itoa(b.Plan.Merge)+" merge")
						@ui.Badge(ui.ToneDanger, strconv.Itoa(b.Plan.Reject)+" reject")
					</span>
				</div>
				for _, r := range b.Plan.Rows {
					@importRowView(r, "add-impw")
				}
				if b.Plan.CanApply() {
					<form class="add-plan-foot" hx-post={ b.Base + "/import/tasmoadmin/apply" } hx-target="#import" hx-swap="outerHTML">
						<input type="hidden" name="csrf" value={ b.CSRF }/>
						<input type="hidden" name="plan" value={ b.Plan.Token }/>
						<span class="add-t2">
							Rejected rows aren’t imported. Fix them in TasmoAdmin and upload again.
							if b.Plan.Probe {
								Devices are probed when you apply.
							}
						</span>
						<button type="submit" class="btn btn-primary">Apply plan · { plural(b.Plan.Create+b.Plan.Merge, "device") }</button>
					</form>
				} else {
					<div class="add-plan-foot">
						<span class="add-t2"><b>Nothing to import.</b> No row of devices.csv can be added or merged. Fix the files and check them again.</span>
					</div>
				}
			</section>
		}
		if b.Report != nil {
			<div class="add-note tone-ok" role="status">
				<span class="add-note-dot" aria-hidden="true"></span>
				<span class="add-note-text"><b>Import finished.</b> { b.Report.Summary }</span>
			</div>
			if b.Report.Hint != "" {
				@ui.Banner(ui.BannerData{Tone: ui.ToneAccent, Text: b.Report.Hint})
			}
			<section class="add-plan add-result" aria-label="Import result">
				for _, r := range b.Report.Rows {
					@importRowView(r, "add-impw add-impw-res")
				}
			</section>
			<div class="btn-row add-result-acts">
				<a class="btn" href={ templ.SafeURL(b.Base + "/import/tasmoadmin/report.csv") } download>Download report</a>
				<a class="btn" href={ templ.SafeURL(b.Base + "/devices/new#card-import") }>Import more files</a>
				<a class="btn btn-primary" href={ templ.SafeURL(b.Base + "/devices") }>Open devices</a>
			</div>
		}
	</div>
}

templ importRowView(r importRow, badgeClass string) {
	<div class="add-improw">
		<span class={ badgeClass }>
			@ui.Badge(r.Tone, r.Label)
		</span>
		<span class="add-improw-dev">
			<span class="add-improw-name">{ r.Name }</span>
			if r.Address != "" {
				<span class="add-improw-ip mono" data-visual-mask>{ r.Address }</span>
			}
		</span>
		<span class="add-improw-why">{ r.Why }</span>
	</div>
}
