package web

import (
	"strconv"
	"strings"

	"github.com/nofuturekid/tasmofleet/internal/model"
	"github.com/nofuturekid/tasmofleet/internal/web/ui"
)

// The device list (design v2 screen "devices", WP P2): page header with the fleet counts, the
// toolbar (search, filter chips with counts, Chip and Tag selects, the phone Sort select and the
// Columns chooser), the table and the phone cards, the bulk bar and the row dialog. The table
// part (#devtable) is reloaded by htmx when the inventory changes (deviceTable); the toolbar
// stays, so a search being typed is never replaced.

// facet is one option of the Chip or Tag select: the value, its label and how many devices have it.
type facet struct {
	Value, Label string
	N            int
}

// sortOption is one entry of the phone Sort select.
type sortOption struct{ Key, Label string }

// phoneSorts are the prototype's phone sort keys (Name, Status, Firmware, Uptime, Wi-Fi signal).
var phoneSorts = []sortOption{{"name", "Name"}, {"status", "Status"}, {"firmware", "Firmware"}, {"uptime", "Uptime"}, {"wifi", "Wi-Fi signal"}}

// sortOptions are the phone sort keys plus the current sort when a table header set another one.
func (p devicesPage) sortOptions() []sortOption {
	out := append([]sortOption(nil), phoneSorts...)
	for _, o := range out {
		if o.Key == p.Sort.Key {
			return out
		}
	}
	for _, cd := range tableDefs["devices"].Cols {
		if cd.ID == p.Sort.Key {
			out = append(out, sortOption{cd.ID, cd.Label})
		}
	}
	return out
}

// chipHref is the list filtered by one chip (key "" = All), keeping the search, the selects
// and the sort. It drops a health filter (?health=online from a dashboard tile): the chips and
// the health filter are one group of status filters, so a chip replaces it, and "All" is the
// whole fleet again from any entry path.
func (p devicesPage) chipHref(base, key string) string {
	f := p.Filter
	f.Chip = key
	f.Health = ""
	return base + "/devices?" + p.Sort.values(f.values()).Encode()
}

// onlineChip is the fixed "Online" chip (health=online, also the dashboard's Online tile). It is
// always rendered; its link switches to the online filter, or drops it again while it is active.
func (p devicesPage) onlineChip(base string) (href string, active bool) {
	f := p.Filter
	active = f.Health == string(model.HealthOnline)
	if active {
		f.Health = ""
	} else {
		f.Chip, f.Health = "", string(model.HealthOnline)
	}
	return base + "/devices?" + p.Sort.values(f.values()).Encode(), active
}

// healthChip is the extra chip for an active health filter other than online (?health=offline
// from a dashboard tile): no fixed chip stands for it, so without it "All" would look active
// while the list is narrowed. Its link drops the filter again. Online has its own fixed chip.
func (p devicesPage) healthChip(base string) (label, href string, n int, ok bool) {
	if p.Filter.Health == "" || p.Filter.Health == string(model.HealthOnline) {
		return "", "", 0, false
	}
	f := p.Filter
	f.Health = ""
	st := model.HealthState(p.Filter.Health)
	return strings.ToUpper(p.Filter.Health[:1]) + p.Filter.Health[1:], base + "/devices?" + p.Sort.values(f.values()).Encode(), p.Summary.States[st], true
}

// countLine is the subtitle: "54 online · 4 offline · 2 unknown".
func (p devicesPage) countLine() string {
	s := p.Summary
	return strconv.Itoa(s.Online) + " online · " + strconv.Itoa(s.Offline) + " offline · " + strconv.Itoa(s.Unknown) + " unknown"
}

templ devicesContent(v view, p devicesPage) {
	@ui.PageHeader("Devices", p.countLine()) {
		if v.IsAdmin {
			if v.Features.Discovery {
				@ui.Button(ui.Btn{Label: "Scan network", Href: v.Base + "/devices/new#card-scan"})
			}
			if p.RowsData.AddHref != "" {
				@ui.Button(ui.Btn{Label: "Add devices", Kind: "primary", Href: p.RowsData.AddHref})
			}
		}
	}
	<div id="list-notice" aria-live="polite"></div>
	if p.RowsData.None {
		@devicesEmpty(v, p)
	} else {
		<div class="dv-list">
			<form class="dv-tools" method="get" action={ templ.SafeURL(v.Base + "/devices") } role="search" aria-label="Filter devices">
				<input type="search" class="dv-q" name="q" value={ p.Filter.Q } placeholder="Filter by name, IP, chip or firmware" aria-label="Filter by name, IP, chip or firmware"/>
				if p.Filter.Chip != "" {
					<input type="hidden" name="chip" value={ p.Filter.Chip }/>
				}
				if p.Filter.Health != "" {
					<input type="hidden" name="health" value={ p.Filter.Health }/>
				}
				<input type="hidden" name="dir" value={ p.Sort.Dir }/>
				<div class="dv-chips">
					for _, c := range p.Summary.Chips {
						<a class="dv-chip" href={ templ.SafeURL(p.chipHref(v.Base, c.Key)) } if c.Key == p.Filter.Chip && (c.Key != "" || p.Filter.Health == "") { aria-current="true" }if c.Title() != "" { title={ c.Title() } }>{ c.Label }<span class="dv-n">{ c.Text() }</span></a>
						if c.Key == "" {
							{{ onlineHref, onlineOn := p.onlineChip(v.Base) }}
							<a class="dv-chip" href={ templ.SafeURL(onlineHref) } if onlineOn { aria-current="true" title="Show all states again" }>Online<span class="dv-n">{ strconv.Itoa(p.Summary.Online) }</span></a>
						}
					}
					if label, href, n, ok := p.healthChip(v.Base); ok {
						<a class="dv-chip" href={ templ.SafeURL(href) } aria-current="true" title="Show all states again">{ label }<span class="dv-n">{ strconv.Itoa(n) }</span></a>
					}
					<span class="dv-vsep" aria-hidden="true"></span>
					<label class={ "dv-pick", templ.KV("on", p.Filter.Family != "") }>
						Chip
						<select name="family" aria-label="Chip" data-autosubmit>
							<option value="">All</option>
							for _, f := range p.Families {
								<option value={ f.Value } selected?={ f.Value == p.Filter.Family }>{ f.Label } · { strconv.Itoa(f.N) }</option>
							}
						</select>
					</label>
					<label class={ "dv-pick", templ.KV("on", p.Filter.Tag != "") }>
						Tag
						<select name="tag" aria-label="Tag" data-autosubmit>
							<option value="">All</option>
							for _, f := range p.Tags {
								<option value={ f.Value } selected?={ f.Value == p.Filter.Tag }>{ f.Label } · { strconv.Itoa(f.N) }</option>
							}
						</select>
					</label>
				</div>
				<span class="dv-grow"></span>
				<label class="dv-sort">
					Sort
					<select name="sort" aria-label="Sort" data-autosubmit>
						for _, o := range p.sortOptions() {
							<option value={ o.Key } selected?={ o.Key == p.Sort.Key }>{ o.Label }</option>
						}
					</select>
				</label>
				<noscript><button type="submit" class="btn">Filter</button></noscript>
			</form>
			if v.Features.DeviceCmd {
				<form id="picker" method="post" action={ templ.SafeURL(v.Base + "/devices/bulk/power") }>
					<input type="hidden" name="csrf" value={ v.CSRF }/>
					@devicesTable(v, p)
					@bulkBar(v)
				</form>
			} else {
				@devicesTable(v, p)
			}
		</div>
	}
	if v.IsAdmin {
		<dialog id="dlg-row" class="udlg" aria-labelledby="dlg-row-h">
			<form method="post" action="" class="udlg-in" data-fill="form">
				<input type="hidden" name="csrf" value={ v.CSRF }/>
				<input type="hidden" name="from" value="list"/>
				<h2 id="dlg-row-h" data-fill="title"></h2>
				<p class="udlg-body" data-fill="text"></p>
				<div class="udlg-foot">
					<button type="button" class="btn" data-close data-fill="dismiss">Cancel</button>
					<button type="submit" class="btn btn-primary" data-fill="verb"></button>
				</div>
			</form>
		</dialog>
	}
}

// devicesTable is the part htmx reloads (#devtable): the Columns slot, then the table and the
// phone cards, or the "no match" box. Device events reload it 0.5 s after the last one of a
// burst (delay), so a burst costs one reload and its last change is never dropped. A throttle
// dropped every change within 2 s of the previous one, and a throttle plus a delay on the same
// event does not help: htmx handles an event once per element, so the delay never ran.
templ devicesTable(v view, p devicesPage) {
	<div id="devtable" hx-get={ v.Base + "/devices/table?" + p.Query } hx-trigger="sse:resync, sse:device delay:500ms" hx-swap="innerHTML">
		@devicesTableBody(v, p)
	</div>
}

templ devicesTableBody(v view, p devicesPage) {
	if p.RowsData.None {
		// the last device was deleted while the page was open (a refresh of this part)
		@devicesEmpty(v, p)
	} else if len(p.Rows) == 0 {
		<div class="dv-nomatch">
			<b>No devices match these filters</b>
			<span>Try a different search or show all devices.</span>
			@ui.Button(ui.Btn{Label: "Clear filters", Href: v.Base + "/devices"})
		</div>
	} else {
		<div class="dv-cols"><i class="colslot"></i></div>
		@rendered([]byte(p.Table))
		@rendered([]byte(p.Cards))
	}
}

// bulkBar is the bar of the selected devices (F5 markup; P2 adds nothing but its place).
templ bulkBar(v view) {
	<div class="bulkbar" data-bulkbar hidden role="region" aria-label="Selected devices">
		<span class="bulk-count"><span data-bar-label>0 devices selected</span><span class="bulk-note" id="bulk-note" data-bar-note hidden></span></span>
		<div class="bulk-acts">
			if v.Features.Updates {
				<button type="submit" data-needs-device class="primary" formaction={ templ.SafeURL(v.Base + "/updates/new") }><span class="bulk-lg">Update firmware</span><span class="bulk-sm">Update</span></button>
			}
			if v.Features.BulkCommand && v.IsAdmin {
				<button type="submit" data-needs-device formaction={ templ.SafeURL(v.Base + "/devices/bulk/command") }><span class="bulk-lg">Send command</span><span class="bulk-sm">Command</span></button>
			}
			if v.Features.BulkBackup && v.IsAdmin {
				<button type="submit" data-needs-device formaction={ templ.SafeURL(v.Base + "/devices/bulk/backup") }>Back up</button>
			}
			if v.Features.BulkRestart && v.IsAdmin {
				<button type="submit" data-needs-device formaction={ templ.SafeURL(v.Base + "/devices/bulk/restart") }>Restart</button>
			}
			<button type="submit" data-needs-device name="action" value="ON">Power on</button>
			<button type="submit" data-needs-device name="action" value="OFF">Power off</button>
		</div>
		<span class="bulk-sep" aria-hidden="true"></span>
		<button type="button" class="bulk-clear" data-pick="none" data-picker="picker">Clear</button>
	</div>
}

// devicesEmpty is the empty fleet: the three ways to add devices (admins), or who can.
templ devicesEmpty(v view, p devicesPage) {
	if v.IsAdmin {
		@ui.Empty("No devices yet", "Scan your network for Tasmota devices, add one by address, or bring over your existing TasmoAdmin setup.") {
			if v.Features.Discovery {
				@ui.Button(ui.Btn{Label: "Scan network", Kind: "primary", Href: v.Base + "/devices/new#card-scan"})
			}
			@ui.Button(ui.Btn{Label: "Add manually", Href: v.Base + "/devices/new"})
			if v.Features.Import {
				@ui.Button(ui.Btn{Label: "Import from TasmoAdmin", Href: v.Base + "/import/tasmoadmin"})
			}
		}
	} else {
		@ui.Empty("No devices yet", "An administrator can add the first ones.")
	}
}
