package web

import (
	"strconv"

	"github.com/nofuturekid/tasmofleet/internal/policy"
	"github.com/nofuturekid/tasmofleet/internal/web/ui"
)

// The rule page and the New rule page (#197). The editor's field pieces (commandField, ruleValue)
// are the policy page's own; the page around them is new.

func severityOptions(sev string) []ui.Option {
	return []ui.Option{
		{Value: policy.SeverityInfo, Label: "Advisory · hint only", Checked: sev == policy.SeverityInfo},
		{Value: policy.SeverityWarn, Label: "Required · counts, preselected in Make compliant", Checked: sev != policy.SeverityInfo},
	}
}

func rulePath(base, id string) string { return base + rulesPath + "/" + id }

// ruleShowHref is the devices card's filter link of a saved rule (the link works without
// JavaScript; with it the editor swaps the card, see ruleDevChip).
func ruleShowHref(v ruleDevicesView, show string, all bool) string {
	q := ""
	if show != "" {
		q = "?show=" + show
	}
	if all {
		if q == "" {
			q = "?all=1"
		} else {
			q += "&all=1"
		}
	}
	return rulePath(v.Base, v.ID) + q
}

func ruleShowPost(v ruleDevicesView, show string, all bool) string {
	q := "?show=" + show
	if show == "" {
		q = "?show=all"
	}
	if all {
		q += "&all=1"
	}
	return v.Base + rulesPath + "/preview" + q
}

func ruleSevTone(required bool) ui.Tone {
	if required {
		return ui.ToneWarn
	}
	return ui.ToneAccent
}

func ruleSevLabel(required bool) string {
	if required {
		return "Required"
	}
	return "Advisory"
}

// rulePageTempl is GET /policy/rules/{id} and the draft of a new rule.
templ rulePageTempl(p rulePageView) {
	<div class="pol-page">
		<div class="pghead">
			<div class="pghead-t">
				@rulePageTitle(p.Name, p.Required, p.Draft, p.Disabled, false)
				@ruleLine_(p.Line, false)
			</div>
			<div class="pghead-acts">
				if !p.Draft {
					<form method="post" action={ templ.SafeURL(p.Base + policyPath + "/live") } class="pol-inline">
						<input type="hidden" name="csrf" value={ p.CSRF }/>
						<input type="hidden" name="rule" value={ p.ID }/>
						if p.Disabled {
							<button type="submit" class="btn" disabled aria-describedby="chk-why">Check now</button>
							<span class="sr-only" id="chk-why">Not checked while the rule is disabled.</span>
						} else {
							<button type="submit" class="btn">Check now</button>
						}
					</form>
				}
				if p.Admin && !p.Draft {
					<a class="btn" href={ templ.SafeURL(p.Base + rulesPath + "/duplicate?id=" + p.ID) }>Duplicate</a>
					if p.Disabled {
						@ruleOpForm(p, "/enable", "rule", "Enable")
					} else {
						@ruleOpForm(p, "/disable", "rule", "Disable")
					}
					<a class="btn btn-danger" href={ templ.SafeURL(p.Base + rulesPath + "/delete?id=" + p.ID) } data-dialog="dlg-rule-delete">Delete…</a>
				}
			</div>
		</div>
		if p.Banner != "" {
			@ui.Banner(ui.BannerData{Tone: p.BannerTone, Text: p.Banner, Alert: p.BannerTone == ui.ToneDanger})
		}
		@ruleSource(p.Source, false)
		<div class="devlive">
			@ruleTilesRow(p.Tiles, false)
			<div class="dev-pair">
			if p.Editor != nil {
				@ruleEditCard(p, p.Editor)
			} else {
				<section class="devcard" aria-labelledby="dc-rule">
					<div class="devcard-head"><h2 id="dc-rule">Rule</h2></div>
					@ui.KV(p.KV)
				</section>
			}
			@ruleDevicesCard(p.Devices)
			</div>
			if len(p.History) > 0 {
				<details class="devcard" id="rule-history">
					<summary>History of this rule</summary>
					<div class="pol-hist-list">
						for _, v := range p.History {
							<a class="pol-hv" href={ templ.SafeURL(p.Base + policyHistoryPath + "?v=" + vstr(v.ID) + "#diff") }>
								<span class="pol-hv-v">v{ vstr(v.ID) }</span>
								<span class="pol-hv-main">
									<span class="pol-hv-what">
										<span>{ v.Summary }</span>
										if v.Note != "" {
											<span class="pol-hnote" title={ v.NoteFull }>“{ v.Note }”</span>
										}
										if v.Current {
											@ui.Badge(ui.ToneOK, "Current")
										}
									</span>
									<span class="pol-hv-meta"><time { ui.StampAttrs(v.At, ui.StampShort)... }>{ ui.StampText(v.At, ui.StampShort) }</time> · { v.By }</span>
								</span>
							</a>
						}
					</div>
					<p class="pol-none"><a href={ templ.SafeURL(p.Base + policyHistoryPath) }>All policy history →</a></p>
				</details>
			}
		</div>
		if p.Admin && !p.Draft {
			@ui.Dialog(ui.DialogData{
				ID: "dlg-rule-delete", Title: "Delete rule “" + p.Name + "”?", Body: p.DeleteText,
				Action: p.Base + rulesPath + "/delete", CSRF: p.CSRF,
				Fields: []ui.KVRow{{Key: "id", Value: p.ID}, {Key: "version", Value: vstr(p.Version)}},
				Verb:   "Delete rule", Danger: true,
			})
		}
		<script src={ p.Base + "/static/" + asset("policy.js") } defer></script>
	</div>
}

templ ruleOpForm(p rulePageView, path, back, label string) {
	<form method="post" action={ templ.SafeURL(p.Base + rulesPath + path) } class="pol-inline">
		<input type="hidden" name="csrf" value={ p.CSRF }/>
		<input type="hidden" name="version" value={ vstr(p.Version) }/>
		<input type="hidden" name="id" value={ p.ID }/>
		if back != "" {
			<input type="hidden" name="back" value={ back }/>
		}
		<button type="submit" class="btn">{ label }</button>
	</form>
}

// ruleLine_ is the line under the title; the preview swaps it out-of-band.
templ ruleLine_(line string, oob bool) {
	<p id="rule-line" class="pghead-sub mono" if oob { hx-swap-oob="true" }>{ line }</p>
}

// ruleTilesRow is the four tiles; the preview swaps them out-of-band so they describe the draft.
templ ruleTilesRow(tiles []ruleTile, oob bool) {
	<div id="rule-tiles" class="dev-tiles" if oob { hx-swap-oob="true" }>
		for _, t := range tiles {
			<div class="dev-tile" data-tile={ t.Key }>
				<div class="dev-tile-l">{ t.Label }</div>
				<div class={ "dev-tile-v", toneClass(t.Tone) }>{ t.Value }</div>
				<div class="dev-tile-s">{ t.Sub }</div>
			</div>
		}
	</div>
}

// scopeSummaryLine is the summary of the Applies to section; the preview swaps it out-of-band.
templ scopeSummaryLine(v scopeSummary, oob bool) {
	<span id="scope-summary" class="ufield-help pol-sec-sum" if oob { hx-swap-oob="true" }>
		Now:
		{ " " }
		if v.Count != "" {
			<b>{ v.Count }</b>
			{ " · " }
		}
		{ v.Text }
	</span>
}

// rulePageTitle is the page title with its badges; the preview swaps it so it follows the Name field.
templ rulePageTitle(name string, required, draft, disabled, oob bool) {
	<h1 id="rule-title" if oob { hx-swap-oob="true" }>
		{ name }
		{ " " }
		@ui.Badge(ruleSevTone(required), ruleSevLabel(required))
		{ " " }
		if draft {
			@ui.Badge(ui.ToneNeutral, "Draft")
		} else if disabled {
			@ui.Badge(ui.ToneNeutral, "Disabled")
		} else {
			@ui.Badge(ui.ToneOK, "Enabled")
		}
	</h1>
}

// ruleSource is the notice of where the draft came from; for a draft started from a command the
// preview swaps it, so it names the command being edited.
templ ruleSource(text string, oob bool) {
	<div id="rule-source" if oob { hx-swap-oob="true" }>
		if text != "" {
			@ui.Banner(ui.BannerData{Tone: ui.ToneAccent, Text: text})
		}
	</div>
}

// rulePreviewAnswer is the answer of /policy/rules/preview: the devices card (the swap target)
// and the parts that follow the draft out-of-band.
templ rulePreviewAnswer(card templ.Component, tiles []ruleTile, line string, sum scopeSummary, t ruleHead) {
	@card
	@wantCheck(t.WantWarn, true)
	@rulePageTitle(t.Name, t.Required, t.Draft, t.Disabled, true)
	@ui.CrumbsOOB(t.Crumbs, t.Base)
	@ui.PhoneTitleOOB(t.Name)
	if t.Source != "" {
		@ruleSource(t.Source, true)
	}
	@ruleTilesRow(tiles, true)
	@ruleLine_(line, true)
	@scopeSummaryLine(sum, true)
}

// ruleEditCard is the Rule card: the editor of the rule or draft. The devices card next to it is
// asked for again (htmx) while the form is edited; nothing is stored before "Save rule".
templ ruleEditCard(p rulePageView, e *ruleEditor) {
	<section class="devcard" aria-labelledby="dc-rule">
		<div class="devcard-head">
			<h2 id="dc-rule">Rule</h2>
			<span class="devcard-note">Saving creates a new version</span>
		</div>
		if e.Err != "" && e.ErrField == "" {
			@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: e.Err, Alert: true})
		}
		<form
			id="rule-form"
			method="post"
			action={ templ.SafeURL(p.Base + rulesPath + "/save") }
			hx-post={ p.Base + rulesPath + "/preview" }
			hx-trigger="change, input changed delay:400ms, htmx:afterSwap from:#want-control delay:50ms"
			hx-target="#rule-devices"
			hx-swap="outerHTML"
			novalidate
			class="pol-form"
		>
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			<input type="hidden" name="id" value={ e.ID }/>
			<input type="hidden" name="version" value={ vstr(e.Version) }/>
			if p.Origin != "" {
				<input type="hidden" name="origin" value={ p.Origin }/>
			}
			<label class="ufield">
				<span class="ufield-label">Name</span>
				<input name="name" value={ e.Spec.Name } maxlength="80" placeholder="New rule"/>
			</label>
			<div class="pol-two">
				@commandField(p.Base, e.Cmd, e.ErrField == "command", e.Err, false)
				<div class="ufield" id="want-control">
					@ruleValue(e.Control)
				</div>
			</div>
			@commandCheck(e.Cmd.Check, false)
			@wantCheck(e.WantWarn, false)
			if e.ErrField == "want" {
				<span class="ufield-err" id="err-want" role="alert">{ e.Err }</span>
			}
			<div class="ufield">
				<span class="ufield-label" id="sev-l">When a device deviates</span>
				@ui.Segmented("When a device deviates", "severity", severityOptions(e.Spec.Severity))
				<span class="ufield-help">Nothing is ever written to devices automatically.</span>
			</div>
			@ruleScopeSection(e, p.Scope)
			<div class="pol-sec">
				<label class="ufield">
					<span class="ufield-label">Note</span>
					<textarea name="note" rows="2" maxlength="300" placeholder="Why this rule exists">{ e.Spec.Note }</textarea>
				</label>
			<label class="pol-enabled">
				<input type="hidden" name="state" value="disabled"/>
				<input type="checkbox" name="state" value="enabled" checked?={ e.Enabled }/>
				Enabled
			</label>
			</div>
			<div class="pol-ed-foot">
			<label class="ufield">
					<span class="sr-only">Change note</span>
				<input
					name="change_note"
					aria-label="Change note"
					maxlength="200"
					placeholder="Optional, shown in History"
					if e.ErrField == "change_note" {
						aria-invalid="true"
						aria-describedby="err-change_note"
						autofocus
					}
				/>
				if e.ErrField == "change_note" {
					<span class="ufield-err" id="err-change_note" role="alert">{ e.Err }</span>
				}
			</label>
				<a class="btn" href={ templ.SafeURL(p.Base + policyPath) }>Cancel</a>
				<button type="submit" class="btn btn-primary">Save rule</button>
			</div>
		</form>
	</section>
}

// ruleScopeSection is "Applies to": an always-open, full-width section of the rule form (#235).
// Everything in it is plain form fields (family, tag, device, except), so it works without
// JavaScript; policy.js adds the chips, the device search and moving a tag between its two lists.
templ ruleScopeSection(e *ruleEditor, sum scopeSummary) {
	<section class="pol-sec pol-scope" aria-labelledby="scope-h" data-scope>
		<div class="pol-sec-head">
			<h3 id="scope-h">Applies to</h3>
			@scopeSummaryLine(sum, false)
		</div>
		<div class="ufield">
			<span class="ufield-label" id="fam-l">Chip families <small>(none: every family)</small></span>
			<div class="pol-pills" role="group" aria-labelledby="fam-l">
				for _, f := range e.Families {
					<label class="pol-pill"><input type="checkbox" name="family" value={ f.Value } checked?={ f.On }/><span>{ scopeChipText(f) }</span></label>
				}
			</div>
		</div>
		<div class="pol-scope-cols">
			<div class="ufield">
				<label class="ufield-label" for="scope-tag-add">Tags <small>(a device with any of them)</small></label>
				<div class="pol-pills" data-tag-chips>
					for _, t := range e.Tags {
						if t.On {
							@scopeTagPill(t)
						}
					}
				</div>
				<input id="scope-tag-add" name="tags_extra" placeholder="Add a tag…" autocomplete="off" data-tag-add/>
				<div class="pol-pills" role="group" aria-label="Tags in use">
					<span class="ufield-help">Used:</span>
					<span class="pol-pills" data-tag-used>
						for _, t := range e.Tags {
							if !t.On {
								@scopeTagPill(t)
							}
						}
					</span>
				</div>
			</div>
			<div class="ufield">
				<label class="ufield-label" for="scope-dev-search">Devices <small>(tags and devices together mean either)</small></label>
				<div class="pol-pills pol-chips" data-dev-chips></div>
				<input id="scope-dev-search" type="search" placeholder="Search name, IP or tag…" autocomplete="off" aria-describedby="scope-count" data-scope-search/>
				<div class="pol-results" role="group" aria-label="Matching devices" data-scope-list>
					for _, d := range e.Devices {
						<label class="pol-row" data-search={ d.Search }><input type="checkbox" name="device" value={ d.Name } checked?={ d.On }/><span>{ d.Name }</span><span class="pol-row-meta">{ d.Meta }</span></label>
					}
					<p class="pol-row-none" data-scope-none hidden>No device matches.</p>
				</div>
				<span id="scope-count" class="ufield-help" data-scope-count>{ plural(len(e.Devices), "device") }. Searches name, IP and tag; the list never grows past this box.</span>
			</div>
		</div>
		<div class="ufield">
			<label class="ufield-label" for="scope-except">Exceptions <small>(devices or tags left out even when they match)</small></label>
			<div class="pol-pills pol-except">
				<span class="pol-pills" data-except-chips>
					for _, x := range e.Except {
						<label class="pol-pill pol-exc"><input type="checkbox" name="except" value={ x } checked/><span>{ x }</span><span class="pol-chip-x" aria-hidden="true">×</span></label>
					}
				</span>
				<input id="scope-except" name="except_extra" list="scope-names" placeholder="Search a device or tag…" autocomplete="off" data-except-add/>
				<datalist id="scope-names">
					for _, n := range e.Names {
						<option value={ n }></option>
					}
				</datalist>
			</div>
		</div>
	</section>
}

// scopeTagPill is a tag of the Applies to section: a pill with its device count while unused, a
// chip once ticked (the same checkbox; policy.js moves it between the two lists).
templ scopeTagPill(t scopeTag) {
	<label class="pol-pill pol-tag" data-n={ itoa(t.N) }><input type="checkbox" name="tag" value={ t.Value } checked?={ t.On }/><span>{ t.Value }</span><span class="pol-pill-n">{ itoa(t.N) }</span><span class="pol-chip-x" aria-hidden="true">×</span></label>
}

// ruleDevChip is a filter of the devices card. A saved rule's chip is a link (it works without
// JavaScript) that the editor also turns into a swap; a draft has no page to link to.
templ ruleDevChip(v ruleDevicesView, show, label string, n int) {
	if v.Draft {
		<button type="button" class="dv-chip" hx-post={ ruleShowPost(v, show, false) } hx-include="#rule-form" hx-target="#rule-devices" hx-swap="outerHTML" aria-current?={ v.Show == show }>{ label }<span class="dv-n">{ itoa(n) }</span></button>
	} else if v.Edit {
		<a class="dv-chip" href={ templ.SafeURL(ruleShowHref(v, show, false)) } hx-post={ ruleShowPost(v, show, false) } hx-include="#rule-form" hx-target="#rule-devices" hx-swap="outerHTML" aria-current?={ v.Show == show }>{ label }<span class="dv-n">{ itoa(n) }</span></a>
	} else {
		<a class="dv-chip" href={ templ.SafeURL(ruleShowHref(v, show, false)) } aria-current?={ v.Show == show }>{ label }<span class="dv-n">{ itoa(n) }</span></a>
	}
}

// ruleDevicesCard is the Devices card: what the rule says about each device it judges (also the
// htmx answer of /policy/rules/preview).
templ ruleDevicesCard(v ruleDevicesView) {
	<section id="rule-devices" class="devcard" aria-labelledby="dc-devs">
		<div class="devcard-head">
			<h2 id="dc-devs">Devices</h2>
			if v.Edit {
				<span class="devcard-note">updates as you edit</span>
			}
		</div>
		switch {
			case v.Stat.Hint != "":
				<p class="devcard-note">{ v.Stat.Hint }</p>
			case v.Stat.Err != "":
				<p class="ufield-err" role="alert">{ v.Stat.Err }</p>
			case v.NoDevices:
				@ui.Empty("No devices yet", "The rule has nothing to judge until a device is added.") {
					<a class="btn" href={ templ.SafeURL(v.Base + "/devices") }>Devices</a>
				}
			case v.NAll == 0:
				@ui.Empty("This rule applies to no device", "No device is in its scope. Check the chip family, tags and devices under Applies to.")
			default:
				if v.Disabled {
					<p class="devcard-note">This rule is disabled. The numbers show what it would judge if it were enabled.</p>
				}
				<div class="dv-chips">
					@ruleDevChip(v, "", "All", v.NAll)
					@ruleDevChip(v, "deviate", "Deviate", v.Stat.Deviate)
					@ruleDevChip(v, "unknown", "Not judged", v.Stat.Unknown)
				</div>
				if len(v.Rows) == 0 {
					<p class="devcard-note">No device in this view.</p>
				} else {
					<table class="dense">
						<thead>
							<tr><th>Device</th><th>Actual</th><th>Source</th></tr>
						</thead>
						<tbody>
							for _, r := range v.Rows {
								<tr class={ templ.KV("is-dim", r.Kind == policy.OutcomeUnknown) }>
									<td class="p1" data-label="Device"><a class="mono" href={ templ.SafeURL(v.Base + "/devices/" + devStr(r.ID)) }>{ r.Name }</a></td>
									<td data-label="Actual">
										if r.Have != "" {
											<span class="mono">@ui.Soft(r.Have)</span>
										} else {
											<span aria-label="no value">–</span>
										}
									</td>
									<td data-label="Source">{ r.Source }</td>
								</tr>
							}
						</tbody>
					</table>
				}
				if !v.All && v.Shown > len(v.Rows) {
					if v.Edit {
						<p class="devcard-note"><a href={ templ.SafeURL(ruleShowHref(v, v.Show, true)) } hx-post={ ruleShowPost(v, v.Show, true) } hx-include="#rule-form" hx-target="#rule-devices" hx-swap="outerHTML">Show all { itoa(v.Shown) }</a></p>
					} else {
						<p class="devcard-note"><a href={ templ.SafeURL(ruleShowHref(v, v.Show, true)) }>Show all { itoa(v.Shown) }</a></p>
					}
				}
		}
	</section>
}

// newRulePage is GET /policy/rules/new: templates, any command, copy from a device. Each leads
// to the rule page as an unsaved draft.
templ newRulePage(p newRuleView) {
	<div class="pol-page">
		@ui.PageHeader("New rule", "Start from a template or from any Tasmota command. You can change everything on the next page before saving.")
		if p.Banner != "" {
			@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: p.Banner, Alert: true})
		}
		<div class="dev-pair">
			<section class="devcard" aria-labelledby="dc-tpl">
				<div class="devcard-head">
					<h2 id="dc-tpl">From a template</h2>
					<form method="get" action={ templ.SafeURL(p.Base + rulesPath + "/new") } role="search">
						<input type="search" name="q" value={ p.Q } placeholder="Search…" aria-label="Search templates" data-tpl-search/>
					</form>
				</div>
				if p.NoMatch {
					<p class="devcard-note">No template matches “{ p.Q }”.</p>
				}
				for _, g := range p.Groups {
					<div data-tpl-group>
						<h3 class="devcard-h3">{ g.Name }</h3>
						<div class="pol-tpls">
							for _, c := range g.Cards {
								<a class="pol-tpl" href={ templ.SafeURL(p.Base + rulesPath + "/new?template=" + c.ID) } data-tpl-card>
									<span class="pol-tpl-name">{ c.Title }</span>
									<span class="pol-tpl-kv">{ c.KV }</span>
									<span class="pol-tpl-text">{ c.Hint }</span>
									if c.Already {
										<span class="pol-tpl-use">Already a rule</span>
									}
								</a>
							}
						</div>
					</div>
				}
			</section>
			<div class="pol-cards">
				<section class="devcard" aria-labelledby="dc-any">
					<div class="devcard-head"><h2 id="dc-any">Any command</h2></div>
					<form method="get" action={ templ.SafeURL(p.Base + rulesPath + "/new") } class="pol-form">
						<div class="ufield">
							<label class="ufield-label" for="any-command">Tasmota command</label>
							<input
								id="any-command"
								name="command"
								class="mono"
								data-cmd-suggest={ p.Base + rulesPath + "/command-suggest" }
								value={ p.Command }
								maxlength="32"
								autocomplete="off"
								autocapitalize="off"
								spellcheck="false"
								placeholder="e.g. SetOption45, Sleep, LedState"
								if p.CommandErr != "" {
									aria-invalid="true"
									aria-describedby="err-any-command"
								}
							/>
							<span class="ufield-help">Any command that answers a plain query. Status commands, secrets and commands that act when sent without a value are refused, with the reason.</span>
							if p.CommandErr != "" {
								<span class="ufield-err" id="err-any-command" role="alert">{ p.CommandErr }</span>
							}
						</div>
						<div><button type="submit" class="btn btn-primary">Continue</button></div>
					</form>
				</section>
				<section class="devcard" aria-labelledby="dc-copy">
					<div class="devcard-head"><h2 id="dc-copy">Copy from a device</h2></div>
					<form method="post" action={ templ.SafeURL(p.Base + rulesPath + "/new/copy") } class="pol-form">
						<input type="hidden" name="csrf" value={ p.CSRF }/>
						<p class="devcard-note">Pick a device that is set up right and a setting: its current value becomes the expected value.</p>
						<div class="ufield">
							<label class="ufield-label" for="copy-device">Device</label>
							<select id="copy-device" name="device" required>
								for _, d := range p.Devices {
									<option value={ strconv.FormatInt(d.ID, 10) } selected?={ d.Sel }>{ d.Name }</option>
								}
							</select>
						</div>
						<div class="ufield">
							<label class="ufield-label" for="copy-command">Tasmota command</label>
							<input
								id="copy-command"
								name="command"
								class="mono"
								data-cmd-suggest={ p.Base + rulesPath + "/command-suggest" }
								value={ p.CopyCommand }
								maxlength="32"
								autocomplete="off"
								autocapitalize="off"
								spellcheck="false"
								placeholder="e.g. PowerOnState, Timezone"
								required
								if p.CopyErr != "" {
									aria-invalid="true"
									aria-describedby="err-copy"
								}
							/>
							if p.CopyErr != "" {
								<span class="ufield-err" id="err-copy" role="alert">{ p.CopyErr }</span>
							}
						</div>
						<div><button type="submit" class="btn">Continue</button></div>
					</form>
				</section>
			</div>
		</div>
		<script src={ p.Base + "/static/" + asset("policy.js") } defer></script>
	</div>
}
